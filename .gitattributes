# Normalize line endings: let Git decide text, keep CRLF in the working tree on Windows.
* text=auto

# Explicitly binary
*.png binary
*.jpg binary
*.ico binary
*.pfx binary
*.snk binary
*.lic binary

# C#/project files are text
*.cs   text
*.csproj text
*.props text
*.targets text
*.slnx text
*.json text
*.sql  text
*.md   text
*.yml  text
