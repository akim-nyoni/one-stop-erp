<Window x:Class="One4All.Desktop.DataHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Health" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="VerdictBanner" TargetType="Border">
            <Setter Property="Background" Value="#DDEFE0" />
            <Setter Property="BorderBrush" Value="#9CC9A6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="6,0,6,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Overall}" Value="Warning">
                    <Setter Property="Background" Value="#FBF1D9" />
                    <Setter Property="BorderBrush" Value="#E2C47A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Overall}" Value="Error">
                    <Setter Property="Background" Value="#F6E3E3" />
                    <Setter Property="BorderBrush" Value="#D9A6A6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E6B3D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground" Value="#8A5A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="#8B1E1E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="14,6" FontWeight="SemiBold" Background="#DDEFE0" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
            <StackPanel>
                <TextBlock Text="Data Health" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Unbalanced batches, control account variances, negative stock, unposted batches, orphan balances and the rest of the ledger integrity check - in one view."
                           Foreground="#667" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Verdict -->
        <Border DockPanel.Dock="Top" Style="{StaticResource VerdictBanner}">
            <TextBlock Text="{Binding Verdict}" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A2E" TextWrapping="Wrap" />
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" />
        </Border>

        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Indicators -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6">
                <ListView ItemsSource="{Binding Indicators}" SelectedItem="{Binding SelectedIndicator}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Indicator" Width="200" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Status" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Found" Width="60" DisplayMemberBinding="{Binding Count}" />
                            <GridViewColumn Header="Value" Width="100" DisplayMemberBinding="{Binding Value}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Findings of the selected indicator -->
            <Border Grid.Column="2" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedIndicator.Name, StringFormat='Findings - {0}'}" FontWeight="SemiBold" Foreground="#1E3A2E" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Findings}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
