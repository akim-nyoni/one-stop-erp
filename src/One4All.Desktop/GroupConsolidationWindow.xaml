<Window x:Class="One4All.Desktop.GroupConsolidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Consolidation" Height="620" Width="1060"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ReserveCell" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReserve}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#1E3A6B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <TextBlock Text="Group Consolidation" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
            <TextBlock Text="Consolidated trial balance across companies. Companies in another base currency are translated (IAS 21): assets and liabilities at the closing rate, equity, income and expense at each posting date's rate; the difference is the translation reserve."
                       Foreground="#667" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" />
        </Border>

        <!-- Companies and options -->
        <Border DockPanel.Dock="Left" Width="300" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="8" Margin="6,0,6,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="As at" Foreground="#667" FontSize="12" />
                    <DatePicker SelectedDate="{Binding AsAt}" Margin="0,2,0,6" />
                    <TextBlock Text="Present in" Foreground="#667" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding PresentationCurrency}" Margin="0,2,0,6" />
                    <TextBlock Text="Intercompany accounts to eliminate (comma-separated)" Foreground="#667" FontSize="12" TextWrapping="Wrap" />
                    <TextBox Text="{Binding IntercompanyAccounts, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <Button Content="Consolidate" Padding="14,6" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding ConsolidateCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Companies" FontWeight="SemiBold" Foreground="#1E3A2E" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Companies}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Include}" Content="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Result -->
        <DockPanel Margin="0,0,6,0">
            <Border DockPanel.Dock="Bottom" Background="#EEF3EE" BorderBrush="#C9D6C9" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Totals}" FontWeight="SemiBold" Foreground="#1E3A2E" />
                    <TextBlock Text="{Binding TranslationNote}" Foreground="#445" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6">
                <ListView ItemsSource="{Binding Rows}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Account" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccountCode}" Style="{StaticResource ReserveCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccountName}" Style="{StaticResource ReserveCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Debit" Width="130" DisplayMemberBinding="{Binding Debit}" />
                            <GridViewColumn Header="Credit" Width="130" DisplayMemberBinding="{Binding Credit}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
