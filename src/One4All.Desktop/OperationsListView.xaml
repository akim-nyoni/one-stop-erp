<UserControl x:Class="One4All.Desktop.OperationsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:One4All.Desktop.Localization"
             xmlns:local="clr-namespace:One4All.Desktop"
             Background="White">
    <UserControl.Resources>
        <loc:TextConverter x:Key="Text" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:NotNullToVisibilityConverter x:Key="NotNull" />
    </UserControl.Resources>
    <DockPanel>
        <!-- Toolbar, as the Explorer has it: Add… Edit… Refresh Search -->
        <Border DockPanel.Dock="Top" BorderBrush="#CFD6DC" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding PageText}" Foreground="#7A8A94" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="{loc:T '◀ Previous'}" Padding="8,3" Margin="0,0,4,0" Command="{Binding PreviousPageCommand}" />
                    <Button Content="{loc:T 'Next ▶'}" Padding="8,3" Command="{Binding NextPageCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Padding="8,3" Margin="0,0,6,0" Click="Add_Click" ToolTip="{Binding AddText, Mode=OneWay}" Visibility="{Binding UserCanAdd, Converter={StaticResource Visible}}">
                        <TextBlock><Run Text="➕ " Foreground="#27AE60" /><Run Text="Add" /></TextBlock>
                    </Button>
                    <Button Padding="8,3" Margin="0,0,6,0" Click="Edit_Click" ToolTip="Opens the selected record in the form to change it" Visibility="{Binding ShowEdit, Converter={StaticResource Visible}}">
                        <TextBlock><Run Text="✏ " Foreground="#2E86C1" /><Run Text="Edit" /></TextBlock>
                    </Button>
                    <Button Padding="8,3" Margin="0,0,6,0" Click="Delete_Click" ToolTip="Removes the selected record from use (it is kept in history)" Visibility="{Binding ShowDelete, Converter={StaticResource Visible}}">
                        <TextBlock><Run Text="⛔ " Foreground="#C0392B" /><Run Text="Delete" /></TextBlock>
                    </Button>
                    <Button Padding="8,3" Margin="0,0,6,0" Command="{Binding RefreshCommand}">
                        <TextBlock><Run Text="🔄 " Foreground="#2E86C1" /><Run Text="Refresh" /></TextBlock>
                    </Button>
                    <Button Padding="8,3" Margin="0,0,6,0" Click="WhoTouched_Click" ToolTip="Who touched the selected record">
                        <TextBlock><Run Text="📝 " Foreground="#B9770E" /><Run Text="History" /></TextBlock>
                    </Button>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#7A8A94" />
                    <TextBox x:Name="SearchBox" Width="220" Padding="4,2" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Type to find rows in the list" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Status: how many records -->
        <Border DockPanel.Dock="Bottom" Background="#F3F5F7" BorderBrush="#CFD6DC" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="Status" Foreground="#2B3A42" FontSize="12" />
        </Border>
        <DataGrid x:Name="ListGrid" ItemsSource="{Binding List}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0"
                  RowBackground="White" AlternatingRowBackground="#F7F9FB" AutoGeneratingColumn="ListGrid_AutoGeneratingColumn" MouseDoubleClick="ListGrid_MouseDoubleClick">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C6B75" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:T 'Who touched this record?'}" Click="WhoTouched_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>
