<Window x:Class="One4All.Desktop.CheckDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check Data" Height="580" Width="1080"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="VerdictBanner" TargetType="Border">
            <Setter Property="Background" Value="#F6E3E3" />
            <Setter Property="BorderBrush" Value="#D9A6A6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="6,0,6,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClean}" Value="True">
                    <Setter Property="Background" Value="#DDEFE0" />
                    <Setter Property="BorderBrush" Value="#9CC9A6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SeverityCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A5A00" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="#8B1E1E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Run check" Padding="14,6" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding RunCommand}" />
                <Button Content="Rebuild period balances" Padding="14,6" Margin="8,0,0,0" Command="{Binding RebuildPeriodBalancesCommand}"
                        ToolTip="Restates the cached GL period balances from the posted journal lines (enabled when a period-balance difference was found)." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Check Data" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Verifies that journals balance, numbering has no gaps, and cached balances, stock and open items agree with the records they come from."
                           Foreground="#667" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Verdict -->
        <Border DockPanel.Dock="Top" Style="{StaticResource VerdictBanner}">
            <StackPanel>
                <TextBlock Text="{Binding Verdict}" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A2E" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Coverage}" FontSize="12" Foreground="#445" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" />
        </Border>

        <!-- Findings -->
        <Border Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6" Margin="6,0">
            <ListView ItemsSource="{Binding Rows}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Severity" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Check" Width="150" DisplayMemberBinding="{Binding Check}" />
                        <GridViewColumn Header="Subject" Width="230" DisplayMemberBinding="{Binding Subject}" />
                        <GridViewColumn Header="Expected" Width="95" DisplayMemberBinding="{Binding Expected}" />
                        <GridViewColumn Header="Stored" Width="95" DisplayMemberBinding="{Binding Actual}" />
                        <GridViewColumn Header="Detail" Width="380">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
