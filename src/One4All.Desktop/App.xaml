<Application x:Class="One4All.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:One4All.Desktop">
    <Application.Resources>
        <!-- One4All shell palette (green-on-white, Sage-style dense back office). -->
        <Color x:Key="BrandColor">#2E7D32</Color>
        <Color x:Key="BrandDarkColor">#1B5E20</Color>
        <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
        <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#F0F3F0" />
        <SolidColorBrush x:Key="TreeBrush" Color="#FAFBFA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D6DED6" />

        <Style TargetType="Menu">
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Application.Resources>
</Application>
