<Window x:Class="One4All.Desktop.PeriodCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="Period Close Checklist" Height="560" Width="960"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="VerdictBanner" TargetType="Border">
            <Setter Property="Background" Value="#F6E3E3" />
            <Setter Property="BorderBrush" Value="#D9A6A6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="6,0,6,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReady}" Value="True">
                    <Setter Property="Background" Value="#DDEFE0" />
                    <Setter Property="BorderBrush" Value="#9CC9A6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B1E1E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Passes}" Value="True">
                    <Setter Property="Foreground" Value="#1E6B3A" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Period end" Foreground="#667" FontSize="12" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding PeriodEnd}" Margin="8,0,8,0" />
                <Button Content="Run checks" Padding="14,6" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding RunCommand}" />
                <Button Content="Release deferred journals" Padding="14,6" Margin="8,0,0,0" Command="{Binding ReleaseDeferredCommand}"
                        ToolTip="Posts every deferred journal dated on or before the period end (enabled when the Unposted journals check is outstanding)." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Period Close Checklist" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Everything to clear before closing the period, across every module. Blocking checks must pass; warnings are for review."
                           Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Verdict -->
        <Border DockPanel.Dock="Top" Style="{StaticResource VerdictBanner}">
            <TextBlock Text="{Binding Verdict}" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A2E" TextWrapping="Wrap" />
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" />
        </Border>

        <!-- Checks -->
        <Border Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6" Margin="6,0">
            <ListView ItemsSource="{Binding Rows}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Check" Width="220" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Outstanding" Width="90" DisplayMemberBinding="{Binding Count}" />
                        <GridViewColumn Header="Value" Width="100" DisplayMemberBinding="{Binding Value}" />
                        <GridViewColumn Header="Severity" Width="100" DisplayMemberBinding="{Binding Severity}" />
                        <GridViewColumn Header="Result" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Result}" Style="{StaticResource ResultCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="What is counted" Width="300" DisplayMemberBinding="{Binding Detail}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
