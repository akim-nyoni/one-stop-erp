<Window x:Class="One4All.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:One4All.Desktop"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="One4All ERP" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen" Background="White">
    <Window.Resources>
        <local:StringToBrushConverter x:Key="BrushConv" />

        <!-- Module tile button -->
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="104" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="White" BorderBrush="#E0E6E0" BorderThickness="1" CornerRadius="4">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="26"
                                        Background="{Binding Accent, Converter={StaticResource BrushConv}}">
                                    <TextBlock Text="{Binding Glyph}" FontSize="24" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Title}" Margin="4,10,4,0" TextAlignment="Center"
                                           TextWrapping="Wrap" FontSize="12" Foreground="#333" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="#F5FAF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{x:Static local:ShellWindow.LockCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:ShellWindow.LockCommand}" Executed="Lock_Click" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Menu bar -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="Lock" InputGestureText="Ctrl+L" Click="Lock_Click" />
                <MenuItem Header="Sign-in Security (two-factor)…" Click="OpenTwoFactor_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View" />
            <MenuItem Header="_Maintenance">
                <MenuItem Header="Roles &amp; Permissions…" Click="OpenPermissionEditor_Click" />
            </MenuItem>
            <MenuItem Header="_Transactions">
                <MenuItem Header="Point of Sale — Touch Terminal…" Click="OpenPosTerminal_Click" />
                <Separator />
                <MenuItem Header="My Approvals…" Click="OpenApprovals_Click" />
                <MenuItem Header="My Notifications…" Click="OpenNotifications_Click" />
                <MenuItem Header="Fault Desk…" Click="OpenFaultDesk_Click" />
                <MenuItem Header="Journals Awaiting Approval…" Click="OpenJournalApprovals_Click" />
                <MenuItem Header="Stock Replenishment…" Click="OpenReplenishment_Click" />
                <MenuItem Header="Supplier Payment Run…" Click="OpenPaymentRun_Click" />
                <MenuItem Header="Bank Reconciliation…" Click="OpenBankReconciliation_Click" />
                <MenuItem Header="Supplier Statement Reconciliation…" Click="OpenSupplierReconciliation_Click" />
            </MenuItem>
            <MenuItem Header="_Operations">
                <MenuItem Header="System Manager — Companies, Accounts, Tax, Traders, Items…" Tag="System Manager" Click="OpenOperations_Click" />
                <Separator />
                <MenuItem Header="Customers — Invoices, Credit Notes, Receipts, Statements…" Tag="Customers" Click="OpenOperations_Click" />
                <MenuItem Header="Suppliers — Invoices, Credit Notes, Payments, Statements…" Tag="Suppliers" Click="OpenOperations_Click" />
                <MenuItem Header="Point of Sale — Refunds, Till Events, Gift Cards…" Tag="Point of Sale" Click="OpenOperations_Click" />
                <MenuItem Header="Stock — Lots, Transfers, Stocktakes, Assembly, Pricing…" Tag="Stock" Click="OpenOperations_Click" />
                <MenuItem Header="Purchasing — Requisitions, Orders, Goods Received, Invoice Matching, Budget Gate…" Tag="Purchasing" Click="OpenOperations_Click" />
                <MenuItem Header="Budgeting — Preparation, Review &amp; Approval…" Tag="Budgeting" Click="OpenOperations_Click" />
                <MenuItem Header="CRM — Leads, Activities &amp; Agenda…" Tag="CRM" Click="OpenOperations_Click" />
                <MenuItem Header="Municipality — Enquiry Desk, Meter Readings, Billing Runs, Statements…" Tag="Municipality" Click="OpenOperations_Click" />
                <MenuItem Header="Receipting — Cashier Session, Payments, Reversals…" Tag="Receipting" Click="OpenOperations_Click" />
                <MenuItem Header="Housing — Waiting List, Allocation Runs, Offers, Stands…" Tag="Housing" Click="OpenOperations_Click" />
                <MenuItem Header="Weighbridge…" Tag="Weighbridge" Click="OpenOperations_Click" />
                <MenuItem Header="Fixed Assets — Counts, Maintenance, CWIP…" Tag="Fixed Assets" Click="OpenOperations_Click" />
                <MenuItem Header="Contracts — Variations, BOQ, WBS, Subcontracts, Plant…" Tag="Contracts" Click="OpenOperations_Click" />
                <MenuItem Header="HR &amp; Attendance…" Tag="HR &amp; Attendance" Click="OpenOperations_Click" />
                <MenuItem Header="Banking — Cheques, Standing Orders, Direct Debits…" Tag="Banking" Click="OpenOperations_Click" />
                <MenuItem Header="Approvals — Delegation &amp; Escalation…" Tag="Approvals" Click="OpenOperations_Click" />
                <MenuItem Header="Sales &amp; Schools — Deliveries, Wallets…" Tag="Sales &amp; Schools" Click="OpenOperations_Click" />
                <Separator />
                <MenuItem Header="Document Printer…" Tag="Documents" Click="OpenOperations_Click" />
            </MenuItem>
            <MenuItem Header="_Enquiries">
                <MenuItem Header="Account Enquiry…" Click="OpenAccountEnquiry_Click" />
                <MenuItem Header="Analytics Dashboard…" Click="OpenAnalytics_Click" />
                <MenuItem Header="Credit Control…" Click="OpenCreditControl_Click" />
                <MenuItem Header="Customer Documents…" Click="OpenCustomerDocuments_Click" />
                <MenuItem Header="Group Consolidation…" Click="OpenGroupConsolidation_Click" />
                <MenuItem Header="Title Deed Pipeline…" Click="OpenTitlePipeline_Click" />
            </MenuItem>
            <MenuItem Header="_Reports">
                <MenuItem Header="Report Viewer…" Click="OpenReportViewer_Click" />
                <MenuItem Header="Report Designer…" Click="OpenBandedDesigner_Click" />
                <MenuItem Header="Quick Column Layout…" Click="OpenReportDesigner_Click" />
            </MenuItem>
            <MenuItem Header="_Utilities">
                <MenuItem Header="Period Close Checklist…" Click="OpenPeriodClose_Click" />
                <MenuItem Header="Bank Rules…" Click="OpenBankRules_Click" />
                <MenuItem Header="Audit Trail…" Click="OpenAuditTrail_Click" />
                <MenuItem Header="Check Data…" Click="OpenCheckData_Click" />
                <MenuItem Header="Data Health…" Click="OpenDataHealth_Click" />
                <MenuItem Header="Scheduled Jobs…" Click="OpenScheduledJobs_Click" />
            </MenuItem>
            <MenuItem Header="_Help" />
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="8,5">
                <Button Content="Exit" Padding="10,3" Click="Exit_Click" DockPanel.Dock="Left" Margin="0,0,8,0" />
                <Button Content="◀ Back" Padding="10,3" IsEnabled="False" DockPanel.Dock="Left" Margin="0,0,4,0" />
                <Button Content="Forward ▶" Padding="10,3" IsEnabled="False" DockPanel.Dock="Left" Margin="0,0,12,0" />
                <Button Content="★ Favourites" Padding="10,3" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding LicenceStatusText}" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Margin="12,0" Foreground="#556" FontSize="12" />
                <TextBox DockPanel.Dock="Right" Width="180" Height="24" VerticalContentAlignment="Center"
                         Padding="6,0" Text="Search" Foreground="#999" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandBrush}">
            <DockPanel Margin="10,4">
                <TextBlock Text="{Binding UserDisplayName, StringFormat='Signed in: {0}'}" Foreground="White" FontSize="12" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding LicenceStatusText}" Foreground="#DCEFDD" FontSize="12" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <!-- Main: System Tree + content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- System Tree -->
            <DockPanel Grid.Column="0" Background="{StaticResource TreeBrush}">
                <Border DockPanel.Dock="Top" Background="#ECF1EC" Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="System Tree" FontWeight="SemiBold" Foreground="#445" />
                </Border>
                <TreeView BorderThickness="0" Background="Transparent" Padding="4">
                    <TreeViewItem Header="{Binding TreeRoot.Title}" IsExpanded="True"
                                  ItemsSource="{Binding TreeRoot.Children}">
                        <TreeViewItem.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:NavNode}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" />
                            </HierarchicalDataTemplate>
                        </TreeViewItem.ItemTemplate>
                    </TreeViewItem>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- Content -->
            <DockPanel Grid.Column="2" Margin="0">
                <Border DockPanel.Dock="Top" Padding="18,12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding ContentHeader}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}" />
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding Modules}" Margin="12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TileStyle}"
                                            Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="18,4,18,18" Padding="18" Background="#F8FAF8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ContentMessage}" TextWrapping="Wrap" Foreground="#555" FontSize="13" />
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
