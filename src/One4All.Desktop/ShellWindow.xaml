<Window x:Class="One4All.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:One4All.Desktop"
        xmlns:loc="clr-namespace:One4All.Desktop.Localization"
        xmlns:nav="clr-namespace:One4All.Desktop.Navigation"
        Title="One4All ERP" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" Background="White">
    <Window.Resources>
        <local:StringToBrushConverter x:Key="BrushConv" />
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A plain, clickable card (module on the home page, screen on a module page) -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="White" BorderBrush="#E0E6E0" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="#F3F9F3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row in the module list: lights on hover -->
        <Style x:Key="TreeRow" TargetType="Border">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3EFE5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A module in the list: lit, with a bar in its colour, while it is the one shown -->
        <Style x:Key="ModuleRow" TargetType="Border" BasedOn="{StaticResource TreeRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#D6EBDA" />
                    <Setter Property="BorderBrush" Value="{Binding Accent, Converter={StaticResource BrushConv}}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3EFE5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModuleTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style x:Key="PlainTreeItem" TargetType="TreeViewItem" />

        <!-- The × on an open screen's chip -->
        <Style x:Key="ChipClose" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#778" />
            <Setter Property="ToolTip" Value="Close this screen" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{x:Static local:ShellWindow.LockCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:ShellWindow.SearchCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:ShellWindow.LockCommand}" Executed="Lock_Click" />
        <CommandBinding Command="{x:Static local:ShellWindow.SearchCommand}" Executed="FocusSearch" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Menus: Modules ▸ module ▸ kind of work ▸ screen, and Maintenance / Transactions / Enquiries / Utilities ▸ module ▸ screen -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2">
            <MenuItem Header="{loc:T '_File'}">
                <MenuItem Header="{loc:T 'Home'}" Command="{Binding GoHomeCommand}" />
                <Separator />
                <MenuItem Header="{loc:T 'Lock'}" InputGestureText="Ctrl+L" Click="Lock_Click" />
                <MenuItem Header="{loc:T 'Sign-in Security (two-factor)…'}" Click="OpenTwoFactor_Click" />
                <Separator />
                <MenuItem Header="{loc:T 'Exit'}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem x:Name="ModulesMenu" Header="{loc:T 'M_odules'}" />
            <MenuItem x:Name="MaintenanceMenu" Header="{loc:T '_Maintenance'}" ToolTip="Setting things up: records, rules, rates and policies" />
            <MenuItem x:Name="TransactionsMenu" Header="{loc:T '_Transactions'}" ToolTip="The day-to-day work: documents, payments and postings" />
            <MenuItem x:Name="EnquiriesMenu" Header="{loc:T '_Enquiries'}" ToolTip="Looking things up: statements, balances and positions" />
            <MenuItem x:Name="UtilitiesMenu" Header="{loc:T '_Utilities'}" ToolTip="Period-end runs, imports and housekeeping" />
            <MenuItem Header="{loc:T '_Reports'}">
                <MenuItem Header="{loc:T 'Report Viewer…'}" Click="OpenReportViewer_Click" />
                <MenuItem Header="{loc:T 'Report Designer…'}" Click="OpenBandedDesigner_Click" />
                <MenuItem Header="{loc:T 'Quick Column Layout…'}" Click="OpenReportDesigner_Click" />
            </MenuItem>
            <MenuItem Header="{loc:T '_View'}">
                <MenuItem Header="{loc:T 'Larger Text'}" InputGestureText="Ctrl++" Click="LargerText_Click" />
                <MenuItem Header="{loc:T 'Smaller Text'}" InputGestureText="Ctrl+−" Click="SmallerText_Click" />
                <MenuItem Header="{loc:T 'Normal Text Size'}" InputGestureText="Ctrl+0" Click="NormalText_Click" />
            </MenuItem>
            <MenuItem Header="{loc:T '_Help'}">
                <MenuItem Header="{loc:T 'How to find a screen'}" Click="HowTo_Click" />
                <MenuItem Header="{loc:T 'Check for Updates…'}" Click="CheckForUpdates_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar: home, and a search that finds any screen by what it does -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="8,6">
                <Button Content="🏠  Home" Padding="12,4" Command="{Binding GoHomeCommand}" DockPanel.Dock="Left" Margin="0,0,10,0" ToolTip="Back to the list of modules" />
                <Grid DockPanel.Dock="Left" Width="420">
                    <TextBox x:Name="SearchBox" Height="28" VerticalContentAlignment="Center" Padding="8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             ToolTip="Type what you want to do, e.g. add a product, pay a supplier, register an applicant (Ctrl+F)" />
                    <TextBlock Text="🔍  What do you want to do? (e.g. add a product)" Foreground="#9AA" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding HasSearchResults, Mode=OneWay}" Width="560">
                        <Border Background="White" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                            <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" BorderThickness="0" MaxHeight="440"
                                     MouseLeftButtonUp="SearchList_Click" KeyDown="SearchList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nav:NavEntry}">
                                        <DockPanel Margin="2,3">
                                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" VerticalAlignment="Center"
                                                Background="{Binding Accent, Converter={StaticResource BrushConv}}">
                                            <TextBlock Text="{Binding Glyph}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E3A2E" />
                                            <TextBlock FontSize="11" Foreground="#778">
                                                <Run Text="{Binding ModuleTitle, Mode=OneWay}" /><Run Text="  ›  " /><Run Text="{Binding GroupTitle, Mode=OneWay}" /><Run Text="  —  " /><Run Text="{Binding Purpose, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandBrush}">
            <DockPanel Margin="10,4" LastChildFill="False">
                <TextBlock Text="{Binding UserDisplayName, StringFormat='Signed in: {0}'}" Foreground="White" FontSize="12" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding LicenceStatusText, StringFormat='Licence: {0}'}" Foreground="#DCEFDD" FontSize="12" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Modules: each opens to its kinds of work and screens; the module shown is lit -->
            <DockPanel Grid.Column="0" Background="{StaticResource TreeBrush}">
                <Border DockPanel.Dock="Top" Background="#ECF1EC" Padding="10,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Modules" FontWeight="SemiBold" Foreground="#445" />
                </Border>
                <TreeView x:Name="ModuleTree" BorderThickness="0" Background="Transparent" Padding="4" ItemsSource="{Binding NavModules}"
                          ItemContainerStyle="{StaticResource ModuleTreeItem}"
                          SelectedItemChanged="ModuleTree_SelectedItemChanged" MouseLeftButtonUp="ModuleTree_MouseLeftButtonUp" KeyDown="ModuleTree_KeyDown">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type nav:NavModule}" ItemsSource="{Binding Categories}" ItemContainerStyle="{StaticResource PlainTreeItem}">
                            <Border Style="{StaticResource ModuleRow}" ToolTip="{Binding Purpose}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="24" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground" Value="{Binding Accent, Converter={StaticResource BrushConv}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type nav:NavCategory}" ItemsSource="{Binding Entries}" ItemContainerStyle="{StaticResource PlainTreeItem}">
                            <Border Style="{StaticResource TreeRow}" ToolTip="{Binding Purpose}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="22" />
                                    <TextBlock Text="{Binding Title}" Foreground="#445" />
                                    <TextBlock Text="{Binding Entries.Count, StringFormat='  ({0})'}" Foreground="#99A" />
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type nav:NavEntry}">
                            <Border Style="{StaticResource TreeRow}" ToolTip="{Binding Purpose}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="22" FontSize="11" VerticalAlignment="Center" Foreground="{Binding Accent, Converter={StaticResource BrushConv}}" />
                                    <TextBlock Text="{Binding Title}" Foreground="#1E5E2E" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- The page: Home (a card per module) or a module (every screen, under its kind of work) -->
            <DockPanel Grid.Column="2" Background="#F6F8F6">
                <Border DockPanel.Dock="Top" Padding="22,12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="◀  All modules" Padding="14,6" VerticalAlignment="Center" Command="{Binding GoBackCommand}"
                                ToolTip="Go up one level">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHome}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding Breadcrumb}" Foreground="#8A958A" FontSize="12" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}" />
                            <TextBlock Text="{Binding PageSubtitle}" Foreground="#667" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Open screens: a chip per screen window open; click brings it to the front, × closes it -->
                <Border DockPanel.Dock="Top" Background="#EEF3EE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,5"
                        Visibility="{Binding HasOpenScreens, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Open screens:" Foreground="#667" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" Content="Close all" FontSize="11" Padding="8,2" VerticalAlignment="Center" Click="CloseAllScreens_Click" />
                        <ItemsControl ItemsSource="{Binding OpenScreens, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:OpenScreen}">
                                    <Border Background="White" BorderBrush="{Binding Entry.Accent, Converter={StaticResource BrushConv}}" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="0,2,6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="ShowScreen_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="Bring this screen to the front">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Entry.Glyph}" Margin="0,0,5,0" Foreground="{Binding Entry.Accent, Converter={StaticResource BrushConv}}" />
                                                    <TextBlock Text="{Binding Entry.Title}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="✕" Style="{StaticResource ChipClose}" Click="CloseScreen_Click" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="14">
<!-- Home: the everyday tasks first, then one card per module -->
                        <StackPanel Visibility="{Binding IsHome, Converter={StaticResource Visible}}" VerticalAlignment="Top">
                            <Border Margin="8,0,8,6" Padding="12,8" CornerRadius="6" Background="#EAF4EC" Visibility="{Binding HasQuickStart, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="Quick start — the everyday tasks" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" />
                                    <ItemsControl ItemsSource="{Binding QuickStart}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type nav:NavEntry}">
                                                <Button Style="{StaticResource CardButton}" Margin="0,0,8,4" Padding="12,8" Click="Entry_Click" ToolTip="{Binding Purpose}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="{Binding Accent, Converter={StaticResource BrushConv}}">
                                                            <TextBlock Text="{Binding Glyph}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E3A2E" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding NavModules}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><nav:FillWrapPanel MinItemWidth="290" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type nav:NavModule}">
                                    <Button Style="{StaticResource CardButton}" MinHeight="120" Margin="8" Padding="16,14"
                                            Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="50" Height="50" CornerRadius="25" VerticalAlignment="Top" Margin="0,0,14,0"
                                                    Background="{Binding Accent, Converter={StaticResource BrushConv}}">
                                                <TextBlock Text="{Binding Glyph}" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#223" />
                                                <TextBlock Text="{Binding Purpose}" FontSize="12.5" Foreground="#667" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>

                        <!-- A module: every screen, under a label per kind of work — Maintenance, Transactions, Enquiries, Utilities -->
                        <ItemsControl x:Name="ModuleSections" ItemsSource="{Binding SelectedModule.Categories}" Visibility="{Binding IsModulePage, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type nav:NavCategory}">
                                    <StackPanel Margin="0,0,0,18">
                                        <Border Margin="8,4,8,4" Padding="12,10" CornerRadius="6" Background="White" BorderBrush="{Binding Accent, Converter={StaticResource BrushConv}}" BorderThickness="5,0,0,0">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" Background="{Binding Accent, Converter={StaticResource BrushConv}}">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="#EAF4EC" CornerRadius="9" Padding="10,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource BrandDarkBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="#223" />
                                                    <TextBlock Text="{Binding Purpose}" FontSize="12.5" Foreground="#667" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><nav:FillWrapPanel MinItemWidth="290" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type nav:NavEntry}">
                                                        <Button Style="{StaticResource CardButton}" MinHeight="112" Margin="8" Padding="0" Click="Entry_Click">
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="5" CornerRadius="6,0,0,6" Background="{Binding Accent, Converter={StaticResource BrushConv}}" />
                                                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Margin="14,14,0,0"
                                                                        Background="{Binding Accent, Converter={StaticResource BrushConv}}">
                                                                    <TextBlock Text="{Binding Glyph}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <DockPanel Margin="14,12,14,10">
                                                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                                        <TextBlock DockPanel.Dock="Right" Text="Open  ›" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                                                        <Border Background="#F0F2F0" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left">
                                                                            <TextBlock Text="{Binding GroupTitle}" FontSize="11" Foreground="#667" />
                                                                        </Border>
                                                                    </DockPanel>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A2E" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Purpose}" FontSize="12.5" Foreground="#667" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
