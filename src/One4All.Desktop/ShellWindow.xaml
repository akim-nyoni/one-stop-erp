<Window x:Class="One4All.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:One4All.Desktop"
        xmlns:loc="clr-namespace:One4All.Desktop.Localization"
        xmlns:nav="clr-namespace:One4All.Desktop.Navigation"
        Title="One4All ERP Explorer" Height="820" Width="1400"
        WindowStartupLocation="CenterScreen" Background="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/One4All.Desktop;component/Navigation/TileStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:StringToBrushConverter x:Key="BrushConv" />
            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- A toolbar button: icon and word, flat -->
            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E3EAF0" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Document tabs across the top of the work area -->
            <Style x:Key="DocTab" TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="B" Background="White" BorderBrush="#CFD6DC" BorderThickness="1,1,1,0" Padding="10,4" Margin="0,2,2,0">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#3C7DD9" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter TargetName="B" Property="BorderBrush" Value="#3C7DD9" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The navigation tree: plain rows, the module shown in blue -->
            <Style x:Key="TreeRow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="#2B3A42" />
                <Setter Property="Margin" Value="2,4" />
            </Style>
            <Style x:Key="ModuleTreeItem" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
            <Style x:Key="PlainTreeItem" TargetType="TreeViewItem" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{x:Static local:ShellWindow.LockCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:ShellWindow.SearchCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:ShellWindow.CloseTabCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:ShellWindow.LockCommand}" Executed="Lock_Click" />
        <CommandBinding Command="{x:Static local:ShellWindow.SearchCommand}" Executed="FocusSearch" />
        <CommandBinding Command="{x:Static local:ShellWindow.CloseTabCommand}" Executed="CloseTab" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Menus: Modules ▸ module ▸ kind of work ▸ screen, and Maintenance / Transactions / Enquiries / Utilities ▸ module ▸ screen -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="White" BorderBrush="#CFD6DC" BorderThickness="0,0,0,1" Padding="2">
            <MenuItem Header="{loc:T '_File'}">
                <MenuItem Header="{loc:T 'Home'}" Click="Home_Click" />
                <Separator />
                <MenuItem Header="{loc:T 'Lock'}" InputGestureText="Ctrl+L" Click="Lock_Click" />
                <MenuItem Header="{loc:T 'Sign-in Security (two-factor)…'}" Click="OpenTwoFactor_Click" />
                <Separator />
                <MenuItem Header="{loc:T 'Exit'}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{loc:T '_View'}">
                <MenuItem Header="{loc:T 'Larger Text'}" InputGestureText="Ctrl++" Click="LargerText_Click" />
                <MenuItem Header="{loc:T 'Smaller Text'}" InputGestureText="Ctrl+−" Click="SmallerText_Click" />
                <MenuItem Header="{loc:T 'Normal Text Size'}" InputGestureText="Ctrl+0" Click="NormalText_Click" />
            </MenuItem>
            <MenuItem x:Name="ModulesMenu" Header="{loc:T 'M_odules'}" />
            <MenuItem x:Name="MaintenanceMenu" Header="{loc:T '_Maintenance'}" ToolTip="Setting things up: records, rules, rates and policies" />
            <MenuItem x:Name="TransactionsMenu" Header="{loc:T '_Transactions'}" ToolTip="The day-to-day work: documents, payments and postings" />
            <MenuItem x:Name="ReportsMenu" Header="{loc:T '_Reports'}">
                <MenuItem Header="{loc:T 'Report Viewer…'}" Click="OpenReportViewer_Click" />
                <MenuItem Header="{loc:T 'Report Designer…'}" Click="OpenBandedDesigner_Click" />
                <MenuItem Header="{loc:T 'Quick Column Layout…'}" Click="OpenReportDesigner_Click" />
                <Separator />
            </MenuItem>
            <MenuItem x:Name="EnquiriesMenu" Header="{loc:T '_Enquiries'}" ToolTip="Looking things up: statements, balances and positions" />
            <MenuItem x:Name="UtilitiesMenu" Header="{loc:T '_Utilities'}" ToolTip="Period-end runs, imports and housekeeping" />
            <MenuItem Header="{loc:T '_Help'}">
                <MenuItem Header="{loc:T 'How to find a screen'}" Click="HowTo_Click" />
                <MenuItem Header="{loc:T 'Check for Updates…'}" Click="CheckForUpdates_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar: Exit | Back Forward | Favourites | Search -->
        <Border DockPanel.Dock="Top" Background="#F5F7F9" BorderBrush="#CFD6DC" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,3">
                <Button Style="{StaticResource ToolButton}" Click="Exit_Click" ToolTip="Close One4All">
                    <TextBlock><Run Text="⏻ " Foreground="#C0392B" /><Run Text="Exit" /></TextBlock>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Home_Click" ToolTip="Home (the modules)"><TextBlock><Run Text="⬆ " Foreground="#27AE60" /><Run Text="Home" /></TextBlock></Button>
                <Rectangle Width="1" Fill="#CFD6DC" Margin="6,2" />
                <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Click="Back_Click" ToolTip="Back to the previous tab"><TextBlock><Run Text="◀ " Foreground="#27AE60" /><Run Text="Back" /></TextBlock></Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Click="Forward_Click" ToolTip="Forward"><TextBlock><Run Text="▶ " Foreground="#27AE60" /><Run Text="Forward" /></TextBlock></Button>
                <Rectangle Width="1" Fill="#CFD6DC" Margin="6,2" />
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem x:Name="FavouritesMenu" ToolTip="Screens you pinned: open one, or pin the tab you are on">
                        <MenuItem.Header>
                            <TextBlock><Run Text="⭐ " Foreground="#F1C40F" /><Run Text="Favourites ▾" /></TextBlock>
                        </MenuItem.Header>
                        <MenuItem Header="Pin this tab" Click="PinTab_Click" />
                        <Separator />
                    </MenuItem>
                </Menu>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LicenceStatusText}" Foreground="#7A8A94" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#2B3A42" />
                    <Grid Width="320">
                        <TextBox x:Name="SearchBox" Height="26" VerticalContentAlignment="Center" Padding="6,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Type what you want to do, e.g. add a product, pay a supplier (Ctrl+F)" />
                        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding HasSearchResults, Mode=OneWay}" Width="560">
                            <Border Background="White" BorderBrush="#3C7DD9" BorderThickness="1" Padding="4">
                                <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" BorderThickness="0" MaxHeight="440"
                                         MouseLeftButtonUp="SearchList_Click" KeyDown="SearchList_KeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type nav:NavEntry}">
                                            <DockPanel Margin="2,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="28" FontSize="16" VerticalAlignment="Center" Foreground="{Binding AreaBrush}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#2B3A42" />
                                                    <TextBlock FontSize="11" Foreground="#7A8A94">
                                                        <Run Text="{Binding ModuleTitle, Mode=OneWay}" /><Run Text="  ›  " /><Run Text="{Binding GroupTitle, Mode=OneWay}" /><Run Text="  —  " /><Run Text="{Binding Purpose, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock Text="🔎" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <TextBlock />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7F9" BorderBrush="#CFD6DC" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,3" LastChildFill="False">
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="#2B3A42" FontSize="12" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding UserDisplayName, StringFormat='👤 {0}'}" Foreground="#2B3A42" FontSize="12" DockPanel.Dock="Right" Margin="12,0,0,0" />
                <TextBlock Text="{Binding CompanyText}" Foreground="#2B3A42" FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Filter, then the tree — module ▸ kind of work ▸ screen -->
            <DockPanel Grid.Column="0" Background="White">
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <TextBlock Text="Filter:" FontSize="15" Foreground="#2B3A42" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ToolButton}" Click="ClearFilter_Click" ToolTip="Clear the filter" />
                    <TextBox x:Name="FilterBox" Height="26" VerticalContentAlignment="Center" Padding="6,0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Show only the screens whose name contains this" />
                </DockPanel>
                <TreeView x:Name="ModuleTree" BorderThickness="0" Background="Transparent" Padding="4" ItemsSource="{Binding FilteredModules}"
                          ItemContainerStyle="{StaticResource ModuleTreeItem}" SelectedItemChanged="ModuleTree_SelectedItemChanged" MouseDoubleClick="ModuleTree_MouseDoubleClick" KeyDown="ModuleTree_KeyDown">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type nav:NavModule}" ItemsSource="{Binding Categories}" ItemContainerStyle="{StaticResource PlainTreeItem}">
                            <TextBlock Text="{Binding Title}" ToolTip="{Binding Purpose}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TreeRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="#1F6FD0" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type nav:NavCategory}" ItemsSource="{Binding Entries}" ItemContainerStyle="{StaticResource PlainTreeItem}">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TreeRow}" Foreground="{Binding AreaBrush}" ToolTip="{Binding Purpose}" />
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type nav:NavEntry}">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TreeRow}" FontSize="13" ToolTip="{Binding Purpose}" />
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E3EAF0" />

            <!-- Right: document tabs — Home, then each module, kind of work or list opened -->
            <TabControl x:Name="Tabs" Grid.Column="2" BorderThickness="0,1,0,0" BorderBrush="#CFD6DC" Padding="0" Background="White" ItemContainerStyle="{StaticResource DocTab}"
                        SelectionChanged="Tabs_SelectionChanged">
                <TabItem x:Name="HomeTab" Header="Home">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="{Binding Welcome}" Foreground="#7A8A94" FontSize="13" TextWrapping="Wrap" Margin="4,0,4,10" />
                            <Border BorderBrush="#CFD6DC" BorderThickness="1" Padding="8" Margin="0,0,0,12" Visibility="{Binding HasQuickStart, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="Quick start" Style="{StaticResource SectionHeading}" Foreground="{StaticResource PageMuted}" />
                                    <ItemsControl ItemsSource="{Binding QuickStart}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type nav:NavEntry}">
                                                <Button Style="{StaticResource Tile}" Content="{Binding}" ContentTemplate="{StaticResource EntryTile}" Click="Entry_Click" ToolTip="{Binding Purpose}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#CFD6DC" BorderThickness="1" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Modules" Style="{StaticResource SectionHeading}" Foreground="{StaticResource PageMuted}" />
                                    <ItemsControl ItemsSource="{Binding NavModules}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type nav:NavModule}">
                                                <Button Style="{StaticResource Tile}" Click="Module_Click" ToolTip="{Binding Purpose}">
                                                    <StackPanel Width="138">
                                                        <TextBlock Text="{Binding Glyph}" FontSize="40" HorizontalAlignment="Center" Margin="0,4,0,6" Foreground="{Binding Accent, Converter={StaticResource BrushConv}}" />
                                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource PageInk}" TextAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
