<Window x:Class="One4All.Desktop.JournalApprovalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Journals Awaiting Approval" Height="720" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <Button Content="Refresh" Padding="14,6" DockPanel.Dock="Right" Command="{Binding LoadCommand}" />
            <StackPanel>
                <TextBlock Text="Journals Awaiting Approval" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Manual journals held for a second user. Approving posts the journal; rejecting cancels it and needs a reason."
                           Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Reason + actions -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="6,6,6,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reject" Style="{StaticResource ActionButton}" Command="{Binding RejectCommand}" Foreground="#8B1E1E" />
                    <Button Content="Approve &amp; Post" Style="{StaticResource ActionButton}" Command="{Binding ApproveCommand}" FontWeight="SemiBold" Background="#DDEFE0" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Reason (required to reject)" Foreground="#667" FontSize="12" />
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,4" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The chosen journal's lines: what the approver signs off -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6" Margin="6,6,6,0" Height="230">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Details}" FontWeight="SemiBold" Foreground="#1E3A2E" Margin="4,0,0,4" />
                <ListView ItemsSource="{Binding Lines}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Account" Width="280" DisplayMemberBinding="{Binding Account}" />
                            <GridViewColumn Header="Debit" Width="100" DisplayMemberBinding="{Binding Debit}" />
                            <GridViewColumn Header="Credit" Width="100" DisplayMemberBinding="{Binding Credit}" />
                            <GridViewColumn Header="Cost centre" Width="90" DisplayMemberBinding="{Binding CostCentre}" />
                            <GridViewColumn Header="Tax code" Width="80" DisplayMemberBinding="{Binding TaxCode}" />
                            <GridViewColumn Header="Line narrative" Width="260" DisplayMemberBinding="{Binding Narrative}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Journals -->
        <Border Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6" Margin="6,0">
            <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Journal" Width="120" DisplayMemberBinding="{Binding Number}" />
                        <GridViewColumn Header="Date" Width="100" DisplayMemberBinding="{Binding Date}" />
                        <GridViewColumn Header="Narrative" Width="330" DisplayMemberBinding="{Binding Narrative}" />
                        <GridViewColumn Header="Value" Width="120" DisplayMemberBinding="{Binding Value}" />
                        <GridViewColumn Header="Prepared by" Width="120" DisplayMemberBinding="{Binding PreparedBy}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
