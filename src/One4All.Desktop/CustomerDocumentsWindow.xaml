<Window x:Class="One4All.Desktop.CustomerDocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="Customer Documents" Height="680" Width="1100"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <Button Content="Refresh" Padding="14,6" DockPanel.Dock="Right" Command="{Binding LoadCommand}" />
            <StackPanel>
                <TextBlock Text="Customer Documents" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Choose a customer, preview an invoice, credit note or statement, then save it to a file for printing or emailing."
                           Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Left: customer + documents -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Customer" Foreground="#667" FontSize="12" />
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Label" Margin="0,4,0,0" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Preview statement" Padding="12,6" Command="{Binding PreviewStatementCommand}" />
                        <Button DockPanel.Dock="Right" Content="Preview document" Padding="12,6" Margin="0,0,6,0" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding PreviewDocumentCommand}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Statement as at" Foreground="#667" FontSize="12" VerticalAlignment="Center" />
                            <DatePicker SelectedDate="{Binding StatementDate}" Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ListView ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn Header="Number" Width="120" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding Date}" />
                                <GridViewColumn Header="Due" Width="90" DisplayMemberBinding="{Binding Due}" />
                                <GridViewColumn Header="Amount" Width="100" DisplayMemberBinding="{Binding Amount}" />
                                <GridViewColumn Header="Outstanding" Width="100" DisplayMemberBinding="{Binding Outstanding}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Right: preview -->
            <Border Grid.Column="1" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Save…" Padding="12,6" Click="Save_Click" />
                        <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A2E" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" BorderThickness="0" Background="#FAFBFA" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
