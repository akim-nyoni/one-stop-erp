<Window x:Class="One4All.Desktop.NotificationCentreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notifications" Height="520" Width="820"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Unread only" IsChecked="{Binding UnreadOnly}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Mark read" Padding="14,6" Command="{Binding MarkReadCommand}" />
                <Button Content="Refresh" Padding="14,6" Margin="8,0,0,0" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Notifications" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="{Binding Summary}" Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" />
        </Border>

        <Border Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6" Margin="6,0">
            <ListBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding Selected}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="#889" FontSize="11" />
                                <TextBlock Text="{Binding Title}" Foreground="#1E3A2E">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="#445" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
