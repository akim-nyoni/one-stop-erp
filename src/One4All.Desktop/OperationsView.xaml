<UserControl x:Class="One4All.Desktop.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:One4All.Desktop.Localization"
             Background="#F4F6F4" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <loc:TextConverter x:Key="Text" />
    </UserControl.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowsActionList, Converter={StaticResource Visible}}">
                <TextBlock Text="{loc:T 'Module'}" Foreground="#667" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Modules}" SelectedItem="{Binding Module}" Width="180" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="{Binding Subtitle}" Foreground="#667" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ActionColumn" Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Actions -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Margin="6,0,6,0"
                    Visibility="{Binding ShowsActionList, Converter={StaticResource Visible}}">
                <ListBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Selected}" BorderThickness="0" Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title, Converter={StaticResource Text}}" Padding="4,5" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="6,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Form -->
                <Border Grid.Row="0" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Selected.Title, Converter={StaticResource Text}}" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A2E" />
                            <TextBlock Text="{Binding Selected.Description, Converter={StaticResource Text}}" Foreground="#667" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Content="{Binding OkText}" Padding="22,7" MinWidth="100" Background="#DDEFE0" FontWeight="SemiBold" Click="Ok_Click" IsDefault="True"
                                    ToolTip="Saves / runs, then closes when all is well" />
                            <Button DockPanel.Dock="Right" Content="Cancel" Padding="18,7" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" ToolTip="Closes without saving" />
                            <Button DockPanel.Dock="Left" Padding="14,7" Click="ShowList_Click" ToolTip="Opens the records in their own window"
                                    Visibility="{Binding Selected.HasList, Converter={StaticResource Visible}}">
                                <TextBlock><Run Text="📋  " /><Run Text="{Binding Selected.ListTitle, Mode=OneWay, Converter={StaticResource Text}}" /></TextBlock>
                            </Button>
                        </DockPanel>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="{Binding Width}" Margin="0,0,12,8">
                                            <TextBlock Text="{Binding Label, Converter={StaticResource Text}}" Foreground="#667" FontSize="12" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,3,0,0"
                                                     Visibility="{Binding IsText, Converter={StaticResource Visible}}" />
                                            <DatePicker SelectedDate="{Binding DateValue}" Margin="0,3,0,0" SelectedDateFormat="Short"
                                                        Visibility="{Binding IsDate, Converter={StaticResource Visible}}" />
                                            <CheckBox IsChecked="{Binding IsTicked}" Content="{loc:T 'Yes'}" Margin="0,5,0,0"
                                                      Visibility="{Binding IsFlag, Converter={StaticResource Visible}}" />
                                            <ComboBox ItemsSource="{Binding Choices}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"
                                                      IsEditable="{Binding IsLookup}" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="360"
                                                      Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" />
                                            <!-- A document's lines: picked on a grid (it takes the place of the text above when filled) -->
                                            <StackPanel Visibility="{Binding IsLines, Converter={StaticResource Visible}}" Margin="0,4,0,0">
                                                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="220"
                                                          RowHeight="26" GridLinesVisibility="Horizontal" FontSize="12">
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Item" Width="230">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.ItemChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              Text="{Binding Item, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                                                              MaxDropDownHeight="300" BorderThickness="0" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                                        <DataGridTextColumn Header="Price" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                                        <DataGridTextColumn Header="Tax / other" Binding="{Binding Extra, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                                        <DataGridTemplateColumn Width="40">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="✕" Padding="4,0" BorderThickness="0" Background="Transparent" Foreground="#C0392B" ToolTip="Remove the line"
                                                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="+ Line" HorizontalAlignment="Left" Padding="10,2" Margin="0,4,0,0" Command="{Binding AddLineCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Result -->
                <TextBox Grid.Row="1" Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" Padding="8" MinHeight="120" MaxHeight="420"
                         FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderBrush="#D9E0D9"
                         Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="#1E3A2E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter Property="Foreground" Value="#8B1E1E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
