<Window x:Class="One4All.Desktop.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One4All ERP - Locked" Height="400" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}">
            <StackPanel VerticalAlignment="Center" Margin="28,0">
                <TextBlock Text="🔒 Locked" Foreground="White" FontSize="26" FontWeight="Bold" />
                <TextBlock x:Name="UserText" Foreground="#DCEFDD" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,20,28,0">
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBox" Height="32" Padding="6,4" FontSize="14" KeyDown="Field_KeyDown" />

            <TextBlock x:Name="CodeLabel" Text="Authenticator code" FontWeight="SemiBold" Margin="0,14,0,4" />
            <TextBox x:Name="CodeBox" Height="32" Padding="6,4" FontSize="14" KeyDown="Field_KeyDown" />

            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <Button x:Name="UnlockButton" Content="Unlock" Width="150" Height="36" FontSize="14" FontWeight="SemiBold" Foreground="White"
                        Background="{StaticResource BrandDarkBrush}" BorderThickness="0" Click="Unlock_Click" DockPanel.Dock="Left" />
                <Button Content="Sign out and close" Height="36" Padding="12,0" Click="SignOut_Click" DockPanel.Dock="Right" />
            </DockPanel>

            <TextBlock x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#A33" FontSize="12.5" />
        </StackPanel>
    </Grid>
</Window>
