<Window x:Class="One4All.Desktop.SupplierReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="Supplier Statement Reconciliation" Height="700" Width="1200"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E0D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E3A2E" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DifferenceTile" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Setter Property="Background" Value="#F6E3E3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAgreed}" Value="True">
                    <Setter Property="Background" Value="#DDEFE0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B1E1E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAgreed}" Value="True">
                    <Setter Property="Foreground" Value="#1E6B3A" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Supplier" Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Label" Width="280" Margin="8,0,8,0" />
                <Button Content="Auto-allocate supplier" Padding="12,6" Command="{Binding AutoAllocateCommand}"
                        ToolTip="Applies the supplier's payments and credits to their invoices (identical amounts first, then oldest first)." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Supplier Statement Reconciliation" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Agree the supplier's statement to the purchase ledger: by document number, then by amount within a week." Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Balances -->
        <UniformGrid DockPanel.Dock="Top" Columns="3">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Their statement" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding StatementBalance}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Our ledger" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding LedgerBalance}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DifferenceTile}">
                <StackPanel>
                    <TextBlock Text="Difference" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding Difference}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Pasted statement -->
            <Border Grid.Column="0" Style="{StaticResource Tile}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Their statement — one document per line: number, date, amount (credits / payments negative)"
                               Style="{StaticResource TileLabel}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Reconcile" Padding="16,6" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding ReconcileCommand}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Date format" Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="6,0,12,0" Padding="4,2" />
                            <CheckBox Content="Header row" IsChecked="{Binding HasHeader}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Content="Tab separated" IsChecked="{Binding TabSeparated}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox Text="{Binding StatementText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <!-- Result -->
            <Border Grid.Column="1" Style="{StaticResource Tile}">
                <ListView ItemsSource="{Binding Lines}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Result" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Document" Width="170" DisplayMemberBinding="{Binding Document}" />
                            <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding Date}" />
                            <GridViewColumn Header="Theirs" Width="100" DisplayMemberBinding="{Binding Theirs}" />
                            <GridViewColumn Header="Ours" Width="100" DisplayMemberBinding="{Binding Ours}" />
                            <GridViewColumn Header="Difference" Width="100" DisplayMemberBinding="{Binding Difference}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </DockPanel>
</Window>
