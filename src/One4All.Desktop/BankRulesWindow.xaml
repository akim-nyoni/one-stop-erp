<Window x:Class="One4All.Desktop.BankRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="Bank Rules" Height="620" Width="1100"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <Button Content="Refresh" Padding="14,6" DockPanel.Dock="Right" Command="{Binding LoadCommand}" />
            <StackPanel>
                <TextBlock Text="Bank Rules" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Statement lines whose description contains a phrase are posted straight to an account and matched — fees, interest, standing orders."
                           Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Rules -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="8" Margin="6,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Switch on / off" Padding="12,5" Margin="0,8,0,0" Command="{Binding ToggleCommand}" />
                    <ListView ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Priority" Width="60" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Description contains" Width="150" DisplayMemberBinding="{Binding Phrase}" />
                                <GridViewColumn Header="Direction" Width="80" DisplayMemberBinding="{Binding Direction}" />
                                <GridViewColumn Header="Amount range" Width="110" DisplayMemberBinding="{Binding Range}" />
                                <GridViewColumn Header="Post to" Width="70" DisplayMemberBinding="{Binding Account}" />
                                <GridViewColumn Header="Bank" Width="90" DisplayMemberBinding="{Binding Bank}" />
                                <GridViewColumn Header="Status" Width="60" DisplayMemberBinding="{Binding Status}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- New rule -->
            <Border Grid.Column="1" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="New rule" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A2E" />
                        <TextBlock Text="Description contains" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding NewPhrase, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                        <TextBlock Text="Name (optional)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                        <TextBlock Text="Direction" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding NewDirection}" />
                        <TextBlock Text="Amount between (optional)" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewMin, UpdateSourceTrigger=PropertyChanged}" Width="110" Padding="4,2" />
                            <TextBlock Text=" and " VerticalAlignment="Center" Foreground="#667" />
                            <TextBox Text="{Binding NewMax, UpdateSourceTrigger=PropertyChanged}" Width="110" Padding="4,2" />
                        </StackPanel>
                        <TextBlock Text="Applies to" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding NewBank}" DisplayMemberPath="Label" />
                        <TextBlock Text="Post to account" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding NewAccount}" DisplayMemberPath="Label" IsTextSearchEnabled="True" />
                        <TextBlock Text="Narrative (optional)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding NewNarrative, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                        <TextBlock Text="Priority (lower first)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding NewPriority, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Padding="4,2" />
                        <Button Content="Add rule" Padding="14,6" Margin="0,12,0,0" HorizontalAlignment="Left" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding AddCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
