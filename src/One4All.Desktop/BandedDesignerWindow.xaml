<Window x:Class="One4All.Desktop.BandedDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:One4All.Desktop"
        Title="One4All — Report Designer" Height="820" Width="1400"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="Undo" />
        <KeyBinding Key="Y" Modifiers="Control" Command="Redo" />
        <KeyBinding Key="Delete" Command="Delete" />
        <KeyBinding Key="D" Modifiers="Control" Command="{x:Static local:BandedDesignerWindow.DuplicateCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Undo" Executed="Undo_Click" />
        <CommandBinding Command="Redo" Executed="Redo_Click" />
        <CommandBinding Command="Delete" Executed="Delete_Click" />
        <CommandBinding Command="{x:Static local:BandedDesignerWindow.DuplicateCommand}" Executed="Duplicate_Click" />
        <CommandBinding Command="Copy" Executed="Copy_Click" />
        <CommandBinding Command="Cut" Executed="Cut_Click" />
        <CommandBinding Command="Paste" Executed="Paste_Click" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandBrush}">
            <TextBlock x:Name="Status" Foreground="White" FontSize="12" Margin="10,4" />
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <TextBlock Text="Add to" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="BandBox" Width="110" Margin="0,0,4,0" />
                <Button Content="Label" Padding="8,2" Margin="1" Click="AddLabel_Click" />
                <Button Content="Field" Padding="8,2" Margin="1" Click="AddField_Click" />
                <Button Content="Expression" Padding="8,2" Margin="1" Click="AddExpression_Click" />
                <Button Content="Line" Padding="8,2" Margin="1" Click="AddLine_Click" />
                <Button Content="Tick box" Padding="8,2" Margin="1" Click="AddCheckbox_Click" />
                <Button Content="Signature" Padding="8,2" Margin="1" Click="AddSignature_Click" />
                <Button Content="Chart" Padding="8,2" Margin="1" Click="AddChart_Click" ToolTip="A bar chart of the selected field; set its category field in the properties" />
                <Button Content="Rich text" Padding="8,2" Margin="1" Click="AddRichText_Click" ToolTip="Text with **bold**, *italic*, __underline__, line breaks and {Field} values" />
                <Button Content="Image" Padding="8,2" Margin="1" Click="AddImage_Click" ToolTip="A picture from a file (PNG or JPEG), kept in the layout" />
                <Button Content="Logo" Padding="8,2" Margin="1" Click="AddLogo_Click" ToolTip="The company logo (set under System Manager)" />
                <Button Content="Barcode" Padding="8,2" Margin="1" Click="AddBarcode_Click" ToolTip="A Code 128 barcode of the selected field; set BarcodeSymbology to QR, Code39, EAN13 or PDF417 for another kind" />
                <Button Content="Sub-report" Padding="8,2" Margin="1" Click="AddSubReport_Click" ToolTip="Another report run inside this band; set SubReportCode and SubReportLinks (Parameter=Field; ...) in the properties" />
                <Separator Margin="6,0" />
                <Button Content="⇤ Left" Padding="6,2" Margin="1" Tag="Left" Click="Align_Click" />
                <Button Content="Right ⇥" Padding="6,2" Margin="1" Tag="Right" Click="Align_Click" />
                <Button Content="⤒ Top" Padding="6,2" Margin="1" Tag="Top" Click="Align_Click" />
                <Button Content="Bottom ⤓" Padding="6,2" Margin="1" Tag="Bottom" Click="Align_Click" />
                <Button Content="Centre ↔" Padding="6,2" Margin="1" Tag="CenterHorizontally" Click="Align_Click" />
                <Button Content="Centre ↕" Padding="6,2" Margin="1" Tag="CenterVertically" Click="Align_Click" />
                <Button Content="Same width" Padding="6,2" Margin="1" Click="SameWidth_Click" />
                <Button Content="Same height" Padding="6,2" Margin="1" Click="SameHeight_Click" />
                <Button Content="Distribute" Padding="6,2" Margin="1" Click="Distribute_Click" />
                <Separator Margin="6,0" />
                <Button Content="Duplicate" Padding="6,2" Margin="1" Click="Duplicate_Click" ToolTip="Ctrl+D" />
                <Button Content="Copy" Padding="6,2" Margin="1" Click="Copy_Click" ToolTip="Ctrl+C — copy the selected elements; paste them here or in another report" />
                <Button Content="Cut" Padding="6,2" Margin="1" Click="Cut_Click" ToolTip="Ctrl+X" />
                <Button Content="Paste" Padding="6,2" Margin="1" Click="Paste_Click" ToolTip="Ctrl+V — into the band of the selected element, else the 'Add to' band" />
                <Button Content="To front" Padding="6,2" Margin="1" Click="ToFront_Click" ToolTip="Draw the selected elements over the others in their band" />
                <Button Content="To back" Padding="6,2" Margin="1" Click="ToBack_Click" ToolTip="Draw the selected elements behind the others in their band" />
                <Separator Margin="6,0" />
                <Button Content="Group" Padding="6,2" Margin="1" Click="Group_Click" ToolTip="The selected elements move together from now on" />
                <Button Content="Ungroup" Padding="6,2" Margin="1" Click="Ungroup_Click" ToolTip="Release the selected elements from their group" />
                <Button Content="Sort…" Padding="6,2" Margin="1" Click="Sort_Click" ToolTip="How the records are sorted apart from grouping: Field; Other desc" />
                <Button Content="Delete" Padding="6,2" Margin="1" Click="Delete_Click" />
                <Button Content="↶ Undo" Padding="6,2" Margin="1" Click="Undo_Click" />
                <Button Content="Redo ↷" Padding="6,2" Margin="1" Click="Redo_Click" />
                <Separator Margin="6,0" />
                <TextBlock Text="Grid" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="GridBox" Width="55" SelectionChanged="Grid_Changed" />
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Slider x:Name="ZoomSlider" Width="110" Minimum="0.6" Maximum="2.5" Value="1.3" VerticalAlignment="Center" ValueChanged="Zoom_Changed" />
                <Button Content="Page setup…" Padding="6,2" Margin="8,1,1,1" Click="PageSetup_Click" ToolTip="Paper, margins, columns for labels, watermark, background picture, tray and two-sided printing" />
                <Button Content="Data source…" Padding="6,2" Margin="4,1,1,1" Click="DataSource_Click" ToolTip="The SQL query, reporting view or function the report reads, with its fields discovered without running it" />
                <TextBlock Text="Theme" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox x:Name="ThemeBox" Width="110" />
                <Button Content="Apply" Padding="6,2" Margin="1" Click="Theme_Click" />
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Reports and fields -->
            <DockPanel Grid.Column="0" Background="{StaticResource TreeBrush}">
                <StackPanel DockPanel.Dock="Top" Margin="8">
                    <TextBlock Text="Report" FontWeight="SemiBold" />
                    <ComboBox x:Name="ReportBox" DisplayMemberPath="Display" SelectionChanged="Report_Changed" Margin="0,2,0,6" />
                    <DockPanel>
                        <Button Content="New" Width="50" DockPanel.Dock="Right" Click="New_Click" Margin="4,0,0,0" />
                        <TextBox x:Name="NewCodeBox" ToolTip="Code for a new blank report (based on the selected report's data)" />
                    </DockPanel>
                    <TextBlock Text="Fields (double-click to add to the detail band)" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8">
                    <TextBlock Text="Version note" />
                    <TextBox x:Name="NoteBox" Margin="0,2,0,6" />
                    <CheckBox x:Name="MineBox" Content="Save as my own version (only I run it)" Margin="0,0,0,6"
                              ToolTip="Your own version comes before the company's; untick to save the company's version for everyone" />
                    <UniformGrid Columns="2">
                        <Button Content="Preview" Height="30" Margin="0,0,4,0" Click="Preview_Click" />
                        <Button Content="Save version" Height="30" FontWeight="SemiBold" Click="Save_Click" />
                        <Button Content="Import .mrpt…" Height="26" Margin="0,4,4,0" Click="ImportFile_Click" ToolTip="Open a report layout file (from another company or installation) to edit and save here" />
                        <Button Content="Export .mrpt…" Height="26" Margin="0,4,0,0" Click="ExportFile_Click" ToolTip="Save this layout to a file to copy it to another company or installation" />
                    </UniformGrid>
                </StackPanel>
                <ListBox x:Name="FieldList" Margin="8,0" MouseDoubleClick="Field_DoubleClick" />
            </DockPanel>

            <!-- The bands -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E9ECEF">
                <StackPanel x:Name="BandsPanel" Margin="16" HorizontalAlignment="Left" />
            </ScrollViewer>

            <!-- Properties and expression editor -->
            <DockPanel Grid.Column="2" Background="{StaticResource TreeBrush}">
                <StackPanel DockPanel.Dock="Bottom" Margin="8">
                    <TextBlock Text="Expression editor (live preview on the first sample row)" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBox x:Name="ExpressionBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" TextChanged="Expression_Changed" PreviewKeyDown="Expression_PreviewKeyDown" Margin="0,2"
                             ToolTip="Type a field, function or value name and pick from the list (Tab or Enter); fields can be written by name, or Field(&quot;name&quot;) when the name has spaces" />
                    <Popup x:Name="CompletionPopup" PlacementTarget="{Binding ElementName=ExpressionBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#9AA" BorderThickness="1">
                            <ListBox x:Name="CompletionList" MaxHeight="170" MinWidth="240" FontFamily="Consolas" BorderThickness="0" MouseDoubleClick="Completion_DoubleClick" />
                        </Border>
                    </Popup>
                    <TextBlock x:Name="ExpressionResult" TextWrapping="Wrap" Foreground="#2E5E2E" />
                    <Button Content="Use for the selected element" Margin="0,4,0,0" Click="UseExpression_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="SelectionTitle" Text="Properties" FontWeight="SemiBold" Margin="8,8,8,4" />
                <TextBox DockPanel.Dock="Top" x:Name="PropertyFilter" Margin="8,0,8,4" TextChanged="PropertyFilter_Changed" ToolTip="Filter the properties by name (e.g. font, border)" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PropertyList" Margin="8,0">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,6,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock Text="{Binding Name}" Width="110" VerticalAlignment="Center" Foreground="#445" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=Explicit}" Tag="{Binding Name}" LostFocus="Property_LostFocus" KeyDown="Property_KeyDown" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
