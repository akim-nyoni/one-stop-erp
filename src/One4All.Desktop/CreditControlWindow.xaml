<Window x:Class="One4All.Desktop.CreditControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="Credit Control" Height="600" Width="960"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <Button Content="Refresh" Padding="14,6" DockPanel.Dock="Right" Command="{Binding LoadCommand}" />
            <StackPanel>
                <TextBlock Text="Credit Control" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Customers with a balance, limit or hold. Run the review to stop over-limit or overdue accounts, or hold / release by hand."
                           Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Actions -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="6,6,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Review -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Overdue tolerance (days)" Foreground="#667" FontSize="12" VerticalAlignment="Center" />
                    <TextBox Text="{Binding OverdueToleranceDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0,0,0" Padding="6,4" TextAlignment="Right" />
                    <Button Content="Run review" Style="{StaticResource ActionButton}" Command="{Binding ReviewCommand}" Background="#DDEFE0" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Reason -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Reason (required for hold / release)" Foreground="#667" FontSize="12" />
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,4" />
                </StackPanel>

                <!-- Hold / release -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Hold" Style="{StaticResource ActionButton}" Command="{Binding HoldCommand}" Foreground="#8B1E1E" />
                    <Button Content="Release" Style="{StaticResource ActionButton}" Command="{Binding ReleaseCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Exposure list -->
        <Border Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6" Margin="6,0">
            <ListView ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Account" Width="90" DisplayMemberBinding="{Binding Code}" />
                        <GridViewColumn Header="Customer" Width="240" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Credit limit" Width="110" DisplayMemberBinding="{Binding CreditLimit}" />
                        <GridViewColumn Header="Balance" Width="110" DisplayMemberBinding="{Binding Balance}" />
                        <GridViewColumn Header="Available" Width="110" DisplayMemberBinding="{Binding Available}" />
                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
