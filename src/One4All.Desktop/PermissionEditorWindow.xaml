<Window x:Class="One4All.Desktop.PermissionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One4All — Roles &amp; Permissions" Height="720" Width="1080"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <Style x:Key="OpColumnHeader" TargetType="TextBlock">
            <Setter Property="LayoutTransform">
                <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
            </Setter>
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Role:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#445" DockPanel.Dock="Left" />
                <ComboBox Width="240" Height="26" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Display" DockPanel.Dock="Left" Margin="0,0,16,0" />
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#445" DockPanel.Dock="Left" />
                <TextBox Width="200" Height="24" VerticalContentAlignment="Center" Padding="4,0" DockPanel.Dock="Left"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Save" Height="26" Padding="14,0" Click="Save_Click" DockPanel.Dock="Right"
                        Background="{StaticResource BrandBrush}" Foreground="White" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandBrush}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" Margin="10,4" />
        </Border>

        <DataGrid ItemsSource="{Binding PermissionsView}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="All" GridLinesVisibility="All"
                  RowHeaderWidth="0" Margin="0" BorderThickness="0" ColumnWidth="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Module" Binding="{Binding Module}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="Feature" Binding="{Binding Feature}" IsReadOnly="True" Width="240" />

                <DataGridTemplateColumn Header="View">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding View, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanView}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Create">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Create, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCreate}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Edit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Edit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Delete">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Delete, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanDelete}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Print">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Print, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanPrint}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Export">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Export, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanExport}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Post">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Post, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanPost}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Approve">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Approve, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApprove}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Void/Rev">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding VoidReverse, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanVoidReverse}" HorizontalAlignment="Center" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
