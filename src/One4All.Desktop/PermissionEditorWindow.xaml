<Window x:Class="One4All.Desktop.PermissionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One4All — Roles &amp; Permissions" Height="720" Width="1080"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <Style x:Key="OpColumnHeader" TargetType="TextBlock">
            <Setter Property="LayoutTransform">
                <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
            </Setter>
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Role or user:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#445" DockPanel.Dock="Left" />
                <ComboBox Width="300" Height="26" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Display" DockPanel.Dock="Left" Margin="0,0,16,0" />
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#445" DockPanel.Dock="Left" />
                <TextBox Width="200" Height="24" VerticalContentAlignment="Center" Padding="4,0" DockPanel.Dock="Left"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Save" Height="26" Padding="14,0" Click="Save_Click" DockPanel.Dock="Right"
                        Background="{StaticResource BrandBrush}" Foreground="White" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandBrush}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" Margin="10,4" />
        </Border>

        <DataGrid x:Name="Grid" ItemsSource="{Binding PermissionsView}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="All" FrozenColumnCount="1"
                  RowHeaderWidth="0" Margin="0" BorderThickness="0" ColumnWidth="Auto"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="True" Background="#F2F5F9">
                                            <Expander.Header>
                                                <TextBlock FontWeight="SemiBold" Foreground="#223">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}" Foreground="#667" FontWeight="Normal" />
                                                </TextBlock>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Tick the whole row" Tag="row+" Click="Bulk_Click" />
                    <MenuItem Header="Clear the whole row" Tag="row-" Click="Bulk_Click" />
                    <Separator />
                    <MenuItem Header="Tick the whole module" Tag="module+" Click="Bulk_Click" />
                    <MenuItem Header="Clear the whole module" Tag="module-" Click="Bulk_Click" />
                    <Separator />
                    <MenuItem Header="Tick this column for the rows shown" Tag="column+" Click="Bulk_Click" />
                    <MenuItem Header="Clear this column for the rows shown" Tag="column-" Click="Bulk_Click" />
                    <Separator />
                    <MenuItem Header="Tick everything shown" Tag="all+" Click="Bulk_Click" />
                    <MenuItem Header="Clear everything shown" Tag="all-" Click="Bulk_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Feature" Binding="{Binding Feature}" IsReadOnly="True" Width="260" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
