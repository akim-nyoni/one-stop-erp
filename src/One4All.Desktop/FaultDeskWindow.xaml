<Window x:Class="One4All.Desktop.FaultDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fault Desk" Height="640" Width="1120"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SlaCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E6B3D" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAtRisk}" Value="True">
                    <Setter Property="Foreground" Value="#8A5A00" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBreached}" Value="True">
                    <Setter Property="Foreground" Value="#8B1E1E" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="14,6" FontWeight="SemiBold" Background="#DDEFE0" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
            <StackPanel>
                <TextBlock Text="Fault Desk" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="{Binding Summary}" Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" />
        </Border>

        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Log a fault -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="Log a fault" FontWeight="SemiBold" Foreground="#1E3A2E" Margin="0,0,0,8" />
                    <TextBlock Text="Category" FontSize="11" Foreground="#667" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,2,0,6" />
                    <TextBlock Text="Priority" FontSize="11" Foreground="#667" />
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" Margin="0,2,0,6" />
                    <TextBlock Text="Stand / erf (optional)" FontSize="11" Foreground="#667" />
                    <TextBox Text="{Binding StandNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                    <TextBlock Text="Reported by" FontSize="11" Foreground="#667" />
                    <TextBox Text="{Binding ReporterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                    <TextBlock Text="Contact" FontSize="11" Foreground="#667" />
                    <TextBox Text="{Binding ReporterContact, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                    <TextBlock Text="What is wrong, and where" FontSize="11" Foreground="#667" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,8" />
                    <Button Content="Log fault" Padding="14,6" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding LogCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Board and actions -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Take" Padding="12,5" Command="{Binding TakeCommand}" />
                            <Button Content="Resolve" Padding="12,5" Margin="6,0,0,0" Command="{Binding ResolveCommand}" />
                            <Button Content="Close" Padding="12,5" Margin="6,0,0,0" Command="{Binding CloseCommand}" />
                            <Button Content="Reopen" Padding="12,5" Margin="6,0,0,0" Command="{Binding ReopenCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 ToolTip="How it was resolved, or why it is reopened." />
                    </DockPanel>
                </Border>
                <Border Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ListView ItemsSource="{Binding Tickets}" SelectedItem="{Binding Selected}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Reference" Width="120" DisplayMemberBinding="{Binding Reference}" />
                                <GridViewColumn Header="Fault" Width="170" DisplayMemberBinding="{Binding Category}" />
                                <GridViewColumn Header="Priority" Width="75" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Response" Width="80" DisplayMemberBinding="{Binding Response}" />
                                <GridViewColumn Header="Resolution" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource SlaCell}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
