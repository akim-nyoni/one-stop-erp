<Window x:Class="One4All.Desktop.ReportViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One4All — Report Viewer" Height="720" Width="1160"
        WindowStartupLocation="CenterOwner" Background="White">
    <DockPanel>
        <!-- Footer status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandBrush}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" Margin="10,4" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: report picker + parameters + actions -->
            <DockPanel Grid.Column="0" Background="{StaticResource TreeBrush}">
                <Border DockPanel.Dock="Top" Background="#ECF1EC" Padding="10,6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Reports" FontWeight="SemiBold" Foreground="#445" />
                </Border>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Report" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#445" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                              DisplayMemberPath="Display" Height="26" Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Parameters" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#445" />
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Prompt}" FontSize="12" Foreground="#556" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Padding="4,0" />
                                            <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="#99A" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Run" Width="80" Height="28" Command="{Binding RunCommand}"
                                Background="{StaticResource BrandBrush}" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="Export as" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="#556" />
                        <ComboBox x:Name="FormatBox" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}" Width="80" Height="26" />
                        <Button Content="Save…" Width="72" Height="28" Margin="6,0,0,0" Click="Save_Click" />
                    </StackPanel>

                    <Button Grid.Row="4" Content="Close" Width="80" Height="26" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="Close_Click" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" />

            <!-- Right: HTML preview -->
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0">
                <WebBrowser x:Name="Preview" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
