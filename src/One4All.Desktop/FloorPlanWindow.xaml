<Window x:Class="One4All.Desktop.FloorPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurant Floor" Height="720" Width="1180"
        WindowStartupLocation="CenterOwner" Background="#1E272E" FontFamily="Segoe UI">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="16,6" FontWeight="SemiBold" Command="{Binding RefreshCommand}" />
            <StackPanel>
                <TextBlock Text="Restaurant Floor" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="{Binding Summary}" Foreground="#9AA7B0" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Right" Width="260" Margin="8,0,0,0" Background="#26313A" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Table" Foreground="#9AA7B0" FontSize="12" />
                <TextBlock Text="{Binding Selected.Detail, FallbackValue='Tap a table'}" Foreground="White" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,14" />
                <TextBlock Foreground="#9AA7B0" FontSize="11" TextWrapping="Wrap"
                           Text="Green: free. Amber: occupied. Red: past the tab warning (time open or total). Place tables and set the warnings under Restaurant operations; the screen refreshes every 30 seconds." />
            </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1F2A33">
            <ItemsControl ItemsSource="{Binding Tables}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="{Binding Width}" Height="{Binding Height}" Cursor="Hand"
                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                ToolTip="{Binding Detail}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{Binding Fill}" CornerRadius="{Binding CornerRadius}" BorderBrush="White" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Line1}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Line2}" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
