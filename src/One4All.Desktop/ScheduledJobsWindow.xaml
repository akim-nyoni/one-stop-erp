<Window x:Class="One4All.Desktop.ScheduledJobsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled Jobs" Height="600" Width="1080"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="FailedCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastFailed}" Value="True">
                    <Setter Property="Foreground" Value="#8B1E1E" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter Property="Foreground" Value="#8B1E1E" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Run now" Padding="14,6" Command="{Binding RunNowCommand}" />
                <Button Content="Enable / disable" Padding="14,6" Margin="8,0,0,0" Command="{Binding ToggleCommand}" />
                <Button Content="Refresh" Padding="14,6" Margin="8,0,0,0" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Scheduled Jobs" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Message despatch, statements, report subscriptions and other housekeeping, run on their schedules." Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6">
                <ListView ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Job" Width="130" DisplayMemberBinding="{Binding Code}" />
                            <GridViewColumn Header="Task" Width="170" DisplayMemberBinding="{Binding Task}" />
                            <GridViewColumn Header="Schedule" Width="220" DisplayMemberBinding="{Binding Schedule}" />
                            <GridViewColumn Header="Next run" Width="150" DisplayMemberBinding="{Binding NextRun}" />
                            <GridViewColumn Header="Last run" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastRun}" Style="{StaticResource FailedCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#D9E0D9" BorderThickness="1" CornerRadius="6" Padding="6">
                <ListView ItemsSource="{Binding Runs}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Ran" Width="150" DisplayMemberBinding="{Binding When}" />
                            <GridViewColumn Header="Outcome" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Outcome}" Style="{StaticResource FailedCell}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Message" Width="760">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </DockPanel>
</Window>
