<Window x:Class="One4All.Desktop.AccountEnquiryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="Account Enquiry" Height="720" Width="1200"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E0D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E3A2E" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Account" Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Label" Width="280" Margin="8,0,16,0" IsTextSearchEnabled="True" />
                <TextBlock Text="From" Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding FromDate}" Margin="8,0,12,0" />
                <TextBlock Text="To" Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding ToDate}" Margin="8,0,8,0" />
                <Button Content="Show" Padding="14,6" FontWeight="SemiBold" Background="#DDEFE0" Command="{Binding LoadCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Account Enquiry" FontSize="20" FontWeight="Bold" Foreground="#1E3A2E" />
                <TextBlock Text="Every posting on a nominal account with its running balance; select one to see the whole journal." Foreground="#667" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- Totals -->
        <UniformGrid DockPanel.Dock="Top" Columns="4">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Opening balance" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding Opening}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Debits in range" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding TotalDebit}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Credits in range" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding TotalCredit}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Background="#EAF4EC">
                <StackPanel>
                    <TextBlock Text="Closing balance" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding Closing}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EEE8" Padding="10,5" Margin="6,6,6,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334" FontSize="12" />
        </Border>

        <!-- Journal drill-down -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Tile}" MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open document" Command="{Binding OpenSourceDocumentCommand}" Padding="10,2" Margin="8,0,0,0"
                                ToolTip="Open the source document as it prints (an invoice, credit note, receipt...)" />
                        <TextBlock Text="Source document" FontWeight="SemiBold" Foreground="#1E3A2E" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding SourceDocument}" FontFamily="Consolas" FontSize="12" Foreground="#334" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Tile}" Height="230">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{Binding JournalHeading}" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A2E" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding JournalNarrative}" Foreground="#667" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <ListView ItemsSource="{Binding JournalLines}" BorderThickness="0" MouseDoubleClick="JournalLine_DoubleClick"
                          ToolTip="Double-click a line to see its account">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Account" Width="300" DisplayMemberBinding="{Binding Account}" />
                            <GridViewColumn Header="CC / Dept" Width="90" DisplayMemberBinding="{Binding Analysis}" />
                            <GridViewColumn Header="Debit" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Debit}" Style="{StaticResource RightCell}" MinWidth="95" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Credit" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Credit}" Style="{StaticResource RightCell}" MinWidth="95" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Narrative" Width="380" DisplayMemberBinding="{Binding Narrative}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Activity -->
        <Border Style="{StaticResource Tile}">
            <ListView ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedActivity}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding Date}" />
                        <GridViewColumn Header="Journal" Width="120" DisplayMemberBinding="{Binding JournalNumber}" />
                        <GridViewColumn Header="Narrative" Width="420" DisplayMemberBinding="{Binding Narrative}" />
                        <GridViewColumn Header="Debit" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Debit}" Style="{StaticResource RightCell}" MinWidth="105" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Credit" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Credit}" Style="{StaticResource RightCell}" MinWidth="105" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Balance" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance}" Style="{StaticResource RightCell}" MinWidth="115" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
