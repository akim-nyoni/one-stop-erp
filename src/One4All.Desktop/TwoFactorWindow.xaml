<Window x:Class="One4All.Desktop.TwoFactorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign-in Security - Authenticator" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <StackPanel Margin="24,18">
        <TextBlock Text="Two-factor sign-in" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" />

        <!-- Enrol -->
        <GroupBox x:Name="EnrolGroup" Header="Set up an authenticator app" Margin="0,16,0,0" Padding="10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#444"
                           Text="1. Click Start. 2. In your authenticator app (Microsoft, Google, Authy…) add an account by entering the key below, or open the link on a phone. 3. Type the six-digit code it shows and confirm." />
                <Button x:Name="StartButton" Content="Start" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="0,4" Click="Start_Click" />
                <TextBlock Text="Key" FontWeight="SemiBold" Margin="0,12,0,2" />
                <DockPanel>
                    <Button Content="Copy" DockPanel.Dock="Right" Padding="10,2" Margin="6,0,0,0" Click="CopyKey_Click" />
                    <TextBox x:Name="KeyBox" IsReadOnly="True" FontFamily="Consolas" FontSize="15" Padding="4" />
                </DockPanel>
                <TextBlock Text="Link (otpauth)" FontWeight="SemiBold" Margin="0,10,0,2" />
                <DockPanel>
                    <Button Content="Copy" DockPanel.Dock="Right" Padding="10,2" Margin="6,0,0,0" Click="CopyUri_Click" />
                    <TextBox x:Name="UriBox" IsReadOnly="True" FontSize="11" Padding="4" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="Code from the app" FontWeight="SemiBold" Margin="0,10,0,2" />
                <DockPanel>
                    <Button x:Name="ConfirmButton" Content="Confirm" DockPanel.Dock="Right" Padding="14,2" Margin="6,0,0,0" Click="Confirm_Click" IsEnabled="False" />
                    <TextBox x:Name="ConfirmCodeBox" FontSize="15" Padding="4" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- Turn off -->
        <GroupBox x:Name="DisableGroup" Header="Turn two-factor off" Margin="0,16,0,0" Padding="10">
            <StackPanel>
                <TextBlock Text="Confirm it is you: password and a current code." FontSize="12.5" Foreground="#444" />
                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,8,0,2" />
                <PasswordBox x:Name="DisablePasswordBox" Padding="4" FontSize="14" />
                <TextBlock Text="Code" FontWeight="SemiBold" Margin="0,8,0,2" />
                <DockPanel>
                    <Button Content="Turn off" DockPanel.Dock="Right" Padding="14,2" Margin="6,0,0,0" Click="Disable_Click" />
                    <TextBox x:Name="DisableCodeBox" FontSize="15" Padding="4" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12.5" />
    </StackPanel>
</Window>
