<Window x:Class="One4All.Desktop.PosTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="One4All POS" Height="820" Width="1280"
        xmlns:local="clr-namespace:One4All.Desktop"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowBg}" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:CategoryNameConverter x:Key="CategoryName" />

        <!-- Light palette (the High contrast toggle swaps these at run time) -->
        <SolidColorBrush x:Key="WindowBg" Color="#EEF1F5" />
        <SolidColorBrush x:Key="Panel" Color="White" />
        <SolidColorBrush x:Key="Card" Color="#F6F8FA" />
        <SolidColorBrush x:Key="Bar" Color="#2C3E50" />
        <SolidColorBrush x:Key="Ink" Color="#1C2833" />
        <SolidColorBrush x:Key="Muted" Color="#6C7A89" />
        <SolidColorBrush x:Key="EdgeBrush" Color="Transparent" />
        <SolidColorBrush x:Key="Line" Color="#DDE3EA" />
        <Thickness x:Key="Edge">0</Thickness>

        <!-- Touch-sized coloured action button -->
        <Style x:Key="PadButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#34495E" />
            <Setter Property="BorderThickness" Value="{DynamicResource Edge}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keypad key: light, big digits -->
        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource PadButton}">
            <Setter Property="Height" Value="54" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Background" Value="#E6EBF0" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <!-- Function tile: small grey, icon + name -->
        <Style x:Key="FunctionButton" TargetType="Button" BasedOn="{StaticResource PadButton}">
            <Setter Property="Height" Value="58" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#F0F3F6" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <!-- Product tile: a coloured block with the name and the price -->
        <Style x:Key="ProductButton" TargetType="Button" BasedOn="{StaticResource PadButton}">
            <Setter Property="Height" Value="92" />
            <Setter Property="Width" Value="152" />
            <Setter Property="Background" Value="#1F618D" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- A small field in the drawer -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,0,0,1" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F9" Command="{Binding NextCurrencyCommand}" />
    </Window.InputBindings>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: who is at which till -->
        <DockPanel Grid.Row="0" Margin="4,0,4,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛒" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="One4All Point of Sale" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" ToolTip="{Binding FunctionKeysText}">
                        <Run Text="{Binding CashierName, Mode=OneWay}" /><Run Text="   •   " /><Run Text="{Binding ProfileText, Mode=OneWay}" /><Run Text="   •   F-keys: hover for the list" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <Button Content="✕  Close" Style="{StaticResource PadButton}" Height="40" Width="110" FontSize="14" Background="#7F8C8D" Click="Close_Click" DockPanel.Dock="Right" />
            <ToggleButton x:Name="ContrastToggle" Content="High contrast" Width="120" Height="40" Margin="3" FontSize="13" DockPanel.Dock="Right"
                          Checked="Contrast_Changed" Unchecked="Contrast_Changed" ToolTip="Black background, white and yellow text, outlined buttons (accessibility)" />
            <Border DockPanel.Dock="Right" Background="#E67E22" CornerRadius="12" Padding="12,4" Margin="0,0,12,0" VerticalAlignment="Center"
                    Visibility="{Binding PendingOfflineCount, Converter={StaticResource CountToVis}}">
                <TextBlock Text="{Binding SyncState}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
            </Border>
            <TextBlock />
        </DockPanel>

        <!-- What to do next: the one line a new cashier reads, with the float and Open Till while the till is closed -->
        <Border Grid.Row="1" Background="{Binding GuideBrush}" CornerRadius="8" Padding="14,8" Margin="4,0,4,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsTillClosed, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Float in the drawer" Foreground="White" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="110" FontSize="18" Padding="6,2" Text="{Binding OpeningFloat, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Content="▶  Open Till" Style="{StaticResource PadButton}" Height="44" Width="150" FontSize="16" Background="#1E8449" Margin="10,0,0,0" Command="{Binding OpenTillCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding GuideText}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: the ticket - lines and the PLU box -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="10" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Column headings -->
                    <Grid Grid.Row="0" Margin="6,0,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Item" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Quantity" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Price" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Total" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" />
                    </Grid>

                    <!-- Lines -->
                    <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="The ticket is empty - tap a product on the right, or scan it." Foreground="{DynamicResource Muted}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cart.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PosCartLineVm}">
                                        <Border Margin="2,1" Padding="4,3" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#D6E6F5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="118" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Ink}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="#B9770E" FontSize="11" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="−" Style="{StaticResource KeyButton}" Width="32" Height="32" FontSize="18" Margin="0"
                                                            Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center" />
                                                    <Button Content="+" Style="{StaticResource KeyButton}" Width="32" Height="32" FontSize="18" Margin="0"
                                                            Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Line.UnitPriceNet, StringFormat=N2}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding LineGrossText}" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" />
                                                <Button Grid.Column="4" Content="✕" Style="{StaticResource PadButton}" Width="28" Height="28" FontSize="12" Margin="4,0,0,0" Background="#C0392B"
                                                        ToolTip="Remove this line"
                                                        Command="{Binding DataContext.VoidLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- PLU / barcode -->
                    <Border Grid.Row="2" Background="{DynamicResource Bar}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock Text="PLU / scan" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="4,0,10,0" />
                            <Button Content="Enter" Style="{StaticResource PadButton}" Height="36" Width="84" FontSize="14" Background="#1E8449" Command="{Binding ScanCommand}" DockPanel.Dock="Right" Margin="6,0,0,0" />
                            <Button Content="Weigh" Style="{StaticResource PadButton}" Height="36" Width="70" FontSize="13" Background="#6C3483" Command="{Binding WeighCommand}" DockPanel.Dock="Right"
                                    Visibility="{Binding IsScaleVisible, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Tare" Style="{StaticResource PadButton}" Height="36" Width="54" FontSize="12" Background="#5B2C6F" Command="{Binding SetTareCommand}" DockPanel.Dock="Right"
                                    ToolTip="Type the container's weight in kg on the pad, then Tare; nothing typed clears it" Visibility="{Binding IsScaleVisible, Converter={StaticResource BoolToVis}}" />
                            <ToggleButton Content="Hold" Height="36" Width="54" FontSize="12" Margin="3,0,0,0" IsChecked="{Binding HoldWeight}" DockPanel.Dock="Right"
                                    ToolTip="Keep the last stable reading for the next weighed line" Visibility="{Binding IsScaleVisible, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Manual kg" Style="{StaticResource PadButton}" Height="36" Width="72" FontSize="12" Background="#922B21" Command="{Binding ManualWeightCommand}" DockPanel.Dock="Right"
                                    ToolTip="Key the weight on the pad for the selected line (supervisor authority, logged)" Visibility="{Binding IsScaleVisible, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Gift wrap" Style="{StaticResource PadButton}" Height="36" Width="72" FontSize="12" Background="#B9770E" Command="{Binding ToggleGiftWrapCommand}" DockPanel.Dock="Right" ToolTip="Gift-wrap the selected line" />
                            <Button Content="S/N" Style="{StaticResource PadButton}" Height="36" Width="48" FontSize="12" Background="#1F618D" Command="{Binding SerialLineCommand}" DockPanel.Dock="Right" ToolTip="Record the typed serial number on the selected line" />
                            <Button Content="Note" Style="{StaticResource PadButton}" Height="36" Width="52" FontSize="12" Background="#1F618D" Command="{Binding NoteLineCommand}" DockPanel.Dock="Right" ToolTip="Put the typed note on the selected line (kitchen, engraving, request)" />
                            <TextBox Text="{Binding LineNoteEntry, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="13" Padding="4,2" VerticalContentAlignment="Center" Margin="6,0,0,0" DockPanel.Dock="Right"
                                     ToolTip="Note or serial number for the selected line" />
                            <TextBox x:Name="ScanBox" Text="{Binding ScanEntry, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Padding="6,3" VerticalContentAlignment="Center"
                                     ToolTip="Scan a barcode or type a PLU / product code and press Enter (type a quantity on the keypad first for more than one)">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- RIGHT: search, categories, product tiles, then the function tiles and the "more" drawer -->
            <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="10">
                <DockPanel>
                    <!-- Search -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Filters…" Style="{StaticResource FunctionButton}" Height="36" Width="90" Command="{Binding ToggleFinderCommand}" DockPanel.Dock="Right"
                                ToolTip="Find products by brand, supplier, price band, stock, promotion or recent sales" />
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="12,0" Margin="0,0,6,0">
                            <DockPanel>
                                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Muted}" />
                                <TextBox Text="{Binding ScanEntry, UpdateSourceTrigger=PropertyChanged}" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Height="34"
                                         ToolTip="Type part of a product name or its code and press Enter">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFinderOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <TextBlock Text="Brand" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <ComboBox IsEditable="True" Width="110" ItemsSource="{Binding FinderBrands}" Text="{Binding FinderBrand, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0" />
                        <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <ComboBox IsEditable="True" Width="100" ItemsSource="{Binding FinderSuppliers}" Text="{Binding FinderSupplier, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0" />
                        <TextBlock Text="Price" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Width="55" Text="{Binding FinderMinPrice, UpdateSourceTrigger=PropertyChanged}" ToolTip="Lowest price" Margin="4,0,0,0" />
                        <TextBlock Text="–" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="3,0" />
                        <TextBox Width="55" Text="{Binding FinderMaxPrice, UpdateSourceTrigger=PropertyChanged}" ToolTip="Highest price" Margin="0,0,8,0" />
                        <CheckBox Content="In stock" IsChecked="{Binding FinderInStock}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox Content="On promotion" IsChecked="{Binding FinderPromotion}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox Content="Sold this week" IsChecked="{Binding FinderRecent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Find" Width="60" Height="26" Command="{Binding ApplyFinderCommand}" Margin="0,0,4,0" />
                        <Button Content="Clear" Width="60" Height="26" Command="{Binding ClearFinderCommand}" />
                    </WrapPanel>

                    <!-- Categories: blue tiles -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CategoryPath}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,0,0,2" />
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0" Margin="0,0,0,6">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Tile" Background="#1F618D" CornerRadius="6" Padding="14,0" MinWidth="110" Height="48" Cursor="Hand">
                                                <TextBlock Text="{Binding Converter={StaticResource CategoryName}}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#0B3C5D" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.85" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Function tiles (bottom) and the drawer for the rarely used settings -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <WrapPanel>
                            <Button Content="🧾 New sale" Style="{StaticResource FunctionButton}" Width="104" Command="{Binding NewSaleCommand}" />
                            <Button Content="% Discount" Style="{StaticResource FunctionButton}" Width="104" Command="{Binding DiscountSaleCommand}" ToolTip="Type the % on the keypad, then press. Line % off and Price override are under More" />
                            <Button Content="Amount off" Style="{StaticResource FunctionButton}" Width="104" Command="{Binding DiscountSaleAmountCommand}" ToolTip="Type the amount on the keypad, then press: a value off the whole sale, spread over its lines" />
                            <Button Content="✂ Split bill" Style="{StaticResource FunctionButton}" Width="104" Click="SplitBill_Click" />
                            <Button Content="💳 On account" Style="{StaticResource FunctionButton}" Width="104" Command="{Binding TenderAccountCommand}" ToolTip="Charge to the customer account typed under More" />
                            <Button Content="🎁 Tip" Style="{StaticResource FunctionButton}" Width="80" Command="{Binding AddTipCommand}" ToolTip="Type the tip in the PLU box, then press" />
                            <Button Content="↩ Refund" Style="{StaticResource FunctionButton}" Width="90" Background="#FBE3D5" Command="{Binding RefundSaleCommand}" ToolTip="Type the sale number from the receipt in the PLU box; a supervisor authorises" />
                            <Button Content="📊 X-read" Style="{StaticResource FunctionButton}" Width="90" Command="{Binding XReadCommand}" />
                            <Button Content="🔒 Z / Close till" Style="{StaticResource FunctionButton}" Width="112" Background="#F5D6D3" Command="{Binding CloseTillCommand}" ToolTip="Count the drawer under More (counted cash), then close" />
                            <Button Content="🔄 Hand over" Style="{StaticResource FunctionButton}" Width="104" Command="{Binding HandOverCommand}" ToolTip="Count the drawer; the next cashier enters their name and PIN under More" />
                            <Button Content="👤 Switch" Style="{StaticResource FunctionButton}" Width="86" Command="{Binding SwitchCashierCommand}" ToolTip="Quick switch, no count: the next cashier enters their name and PIN under More and takes the till as it is" />
                            <Button Content="☁ Sync offline" Style="{StaticResource FunctionButton}" Width="104" Command="{Binding FlushOfflineCommand}" Visibility="{Binding PendingOfflineCount, Converter={StaticResource CountToVis}}" />
                        </WrapPanel>
                        <Expander Header="More: discounts, loyalty, coupons, parked sales, account settings" Foreground="{DynamicResource Muted}" FontSize="12" Margin="3,4,3,0">
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                <StackPanel>
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="2"><TextBlock Text="Supervisor" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding SupervisorName}" /></StackPanel>
                                        <StackPanel Margin="2"><TextBlock Text="Supervisor PIN" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="SupervisorPinBox" PasswordChanged="SupervisorPin_Changed" /></StackPanel>
                                        <StackPanel Margin="2"><TextBlock Text="Loyalty member" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding LoyaltyMember}" /></StackPanel>
                                        <StackPanel Margin="2"><TextBlock Text="Customer account (On account)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding AccountCustomer, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        <StackPanel Margin="2"><TextBlock Text="Sales rep (commission)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding SalesRep, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    </UniformGrid>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Line % off" Style="{StaticResource FunctionButton}" Height="36" Width="100" Command="{Binding DiscountLineCommand}" ToolTip="Tap the line, type the % on the keypad, press" />
                                        <Button Content="Line amount off" Style="{StaticResource FunctionButton}" Height="36" Width="120" Command="{Binding DiscountLineAmountCommand}" ToolTip="Tap the line, type the amount on the keypad, press" />
                                        <Button Content="Price override" Style="{StaticResource FunctionButton}" Height="36" Width="110" Command="{Binding OverridePriceCommand}" ToolTip="Tap the line, type the price on the keypad, press (supervisor)" />
                                        <Button Content="Clear tenders" Style="{StaticResource FunctionButton}" Height="36" Width="110" Command="{Binding ClearTendersCommand}" />
                                        <TextBox Width="150" Text="{Binding CouponEntry, UpdateSourceTrigger=PropertyChanged}" ToolTip="Coupon code" Margin="8,0,2,0" VerticalContentAlignment="Center" />
                                        <Button Content="Apply coupon" Style="{StaticResource FunctionButton}" Height="36" Width="110" Command="{Binding ApplyCouponCommand}" />
                                        <TextBox Width="130" Text="{Binding VoucherNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gift card number (for VOUCHER)" Margin="8,0,2,0" VerticalContentAlignment="Center" />
                                        <TextBlock Text="← gift card no." Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock Text="Parked sales" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="2,0,6,0" />
                                        <TextBox Width="120" Text="{Binding ParkTag}" ToolTip="Name to park the sale under (Hold)" DockPanel.Dock="Left" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding ParkedSales}" SelectedItem="{Binding SelectedParkedSale}" ToolTip="Choose the parked sale, then press Recall">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock><Run Text="{Binding Tag}" /><Run Text="  ·  " /><Run Text="{Binding Total, StringFormat=N2}" /><Run Text="  ·  " /><Run Text="{Binding ParkedAt, StringFormat=HH:mm}" /></TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>
                                    <UniformGrid Columns="4" Margin="0,6,0,0">
                                        <StackPanel Margin="2"><TextBlock Text="Counted cash (Z / hand over)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding CountedCash}" ToolTip="120, or note by note 50x10+20x5" /></StackPanel>
                                        <StackPanel Margin="2"><TextBlock Text="Prescription ref" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding PrescriptionReference}" /></StackPanel>
                                        <CheckBox Margin="2" VerticalAlignment="Bottom" Content="Age checked" IsChecked="{Binding AgeVerified}" />
                                        <TextBlock />
                                    </UniformGrid>
                                    <Expander Header="Account codes (set once by the accountant)" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0">
                                        <UniformGrid Columns="4" Margin="0,4,0,0">
                                            <StackPanel Margin="2"><TextBlock Text="Cash a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding CashAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Card a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding CardAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Tax a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TaxAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Mobile money a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding MobileMoneyAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Cheques a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ChequeAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Bank transfer a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding BankTransferAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Gift card a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding GiftCardAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Tips a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TipsAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Discount a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding DiscountAccountCode}" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Over/short a/c" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding OverShortAccountCode}" /></StackPanel>
                                        </UniformGrid>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- Product tiles -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PosProductVm}">
                                    <Button Style="{StaticResource ProductButton}" Background="{Binding TileBrush}"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AllowDrop="True" ToolTip="Tap to add one to the ticket"
                                            PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" PreviewMouseMove="Tile_PreviewMouseMove" Drop="Tile_Drop">
                                        <DockPanel Width="136">
                                            <Border DockPanel.Dock="Bottom" Background="#22000000" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PriceText}" Foreground="White" FontSize="15" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Top" FontSize="14" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- RIGHT PANEL: number pad, tenders, totals and PAY -->
            <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="10" Padding="10" Margin="8,0,0,0">
                <DockPanel LastChildFill="False">
                        <!-- Keypad + tenders -->
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="3">
                                    <DockPanel>
                                        <TextBlock Text="Amount" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TenderEntry}" Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="SemiBold" TextAlignment="Right" MinHeight="28" />
                                    </DockPanel>
                                </Border>
                                <UniformGrid Columns="4">
                                    <Button Content="7" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="7" />
                                    <Button Content="8" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="8" />
                                    <Button Content="9" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="9" />
                                    <Button Content="⌫" Style="{StaticResource KeyButton}" FontSize="18" Command="{Binding ClearEntryCommand}" ToolTip="Clear the amount" />
                                    <Button Content="4" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="4" />
                                    <Button Content="5" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="5" />
                                    <Button Content="6" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="6" />
                                    <Button Content="Hold" Style="{StaticResource FunctionButton}" Height="54" Command="{Binding ParkCommand}" ToolTip="Park this sale to serve someone else; Recall brings it back" />
                                    <Button Content="1" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="1" />
                                    <Button Content="2" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="2" />
                                    <Button Content="3" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="3" />
                                    <Button Content="Recall" Style="{StaticResource FunctionButton}" Height="54" Command="{Binding ResumeCommand}" ToolTip="Bring back a parked sale (choose it under More functions)" />
                                    <Button Content="." Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="." />
                                    <Button Content="0" Style="{StaticResource KeyButton}" Command="{Binding AppendDigitCommand}" CommandParameter="0" />
                                    <Button Content="Void" Style="{StaticResource FunctionButton}" Height="54" Background="#F5D6D3" Command="{Binding VoidSaleCommand}" ToolTip="Void a completed sale: type its number in the PLU box and the reason in the note box; a supervisor authorises and is recorded" />
                                    <Button Content="Receipt" Style="{StaticResource FunctionButton}" Height="54" Click="PrintReceipt_Click" ToolTip="Print the last receipt" />
                                    <Button Content="No sale" Style="{StaticResource FunctionButton}" Height="54" Background="#F5EBD3" Command="{Binding NoSaleCommand}" ToolTip="Open the drawer without a sale: type the reason in the note box; a supervisor authorises and the opening is logged" />
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Button Content="CASH" Style="{StaticResource PadButton}" Height="64" FontSize="20" Background="#2980B9" Command="{Binding TenderCashCommand}" ToolTip="Type the cash handed over, then press CASH" />
                                <Button Content="CARD" Style="{StaticResource PadButton}" Height="48" FontSize="16" Background="#8E44AD" Command="{Binding TenderCardCommand}" />
                                <Button Content="MOBILE MONEY" Style="{StaticResource PadButton}" Height="48" FontSize="15" Background="#117A65" Command="{Binding TenderMobileMoneyCommand}" />
                                <UniformGrid Columns="3">
                                    <Button Content="CHEQUE" Style="{StaticResource PadButton}" Height="44" FontSize="12" Background="#5D6D7E" Command="{Binding TenderChequeCommand}" ToolTip="A cheque for the amount on the pad (blank: the balance); no change is given" />
                                    <Button Content="TRANSFER" Style="{StaticResource PadButton}" Height="44" FontSize="12" Background="#1F618D" Command="{Binding TenderBankTransferCommand}" ToolTip="A bank transfer for the amount on the pad (blank: the balance)" />
                                    <Button Content="POINTS" Style="{StaticResource PadButton}" Height="44" FontSize="12" Background="#A04000" Command="{Binding TenderPointsCommand}" ToolTip="Pay with the loyalty member's points (member number under More functions)" />
                                </UniformGrid>
                                <Button Content="SELL GIFT CARD" Style="{StaticResource PadButton}" Height="48" FontSize="13" Background="#7D6608" Command="{Binding SellGiftCardCommand}" ToolTip="Card number in the gift card box, value on the number pad: printed stock activates, an active card tops up, when the sale posts" />
                                <Button Content="VOUCHER / GIFT CARD" Style="{StaticResource PadButton}" Height="48" FontSize="13" Background="#B9770E" Command="{Binding TenderVoucherCommand}" ToolTip="Type the gift card number under More functions first" />
                                <ItemsControl ItemsSource="{Binding CurrencyButtons}" Margin="3,2,3,0" ToolTip="{Binding PayingInText}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Code}" ToolTip="{Binding Tip}" MinWidth="56" Height="30" Margin="1" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                                    Command="{Binding DataContext.PayInCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Code}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#E6EBF0" />
                                                        <Setter Property="Foreground" Value="#1C2833" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="BorderBrush" Value="#C9D1D9" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1F618D" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding BalanceInTenderCurrencyText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,0,0,0" />
                            <Button Content="RECEIPT PREVIEW" Style="{StaticResource PadButton}" Height="40" FontSize="12" Background="#566573" Click="PreviewReceipt_Click"
                                    ToolTip="See the last receipt as it prints, then print it again" />
                            </StackPanel>
                        </Grid>

                        <!-- Totals and PAY -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,8,3,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="PAY" Style="{StaticResource PadButton}" Height="80" Margin="0,8,0,0" FontSize="26" Background="#27AE60" Command="{Binding PayCommand}"
                                        ToolTip="Completes the sale once the tenders cover the total" />
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <DockPanel><TextBlock Text="Subtotal" Foreground="{DynamicResource Muted}" FontSize="12" /><TextBlock Text="{Binding SubtotalText}" Foreground="{DynamicResource Ink}" FontSize="12" DockPanel.Dock="Right" Margin="10,0,14,0" /></DockPanel>
                                        <DockPanel><TextBlock Text="Tax" Foreground="{DynamicResource Muted}" FontSize="12" /><TextBlock Text="{Binding TaxText}" Foreground="{DynamicResource Ink}" FontSize="12" DockPanel.Dock="Right" Margin="10,0,14,0" /></DockPanel>
                                        <DockPanel Margin="0,2,0,0"><TextBlock Text="TOTAL" Foreground="{DynamicResource Ink}" FontWeight="Bold" FontSize="20" /><TextBlock Text="{Binding GrossText}" Foreground="#1E8449" FontWeight="Bold" FontSize="22" DockPanel.Dock="Right" Margin="10,0,14,0" /></DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel><TextBlock Text="Tendered" Foreground="{DynamicResource Muted}" FontSize="12" /><TextBlock Text="{Binding TenderedText}" Foreground="{DynamicResource Ink}" FontSize="12" DockPanel.Dock="Right" Margin="10,0,10,0" /></DockPanel>
                                        <DockPanel><TextBlock Text="Still to pay" Foreground="{DynamicResource Muted}" FontSize="12" /><TextBlock Text="{Binding BalanceText}" Foreground="#D35400" FontWeight="SemiBold" FontSize="12" DockPanel.Dock="Right" Margin="10,0,10,0" /></DockPanel>
                                        <DockPanel Margin="0,2,0,0"><TextBlock Text="CHANGE" Foreground="{DynamicResource Ink}" FontWeight="Bold" FontSize="18" /><TextBlock Text="{Binding ChangeText}" Foreground="#1F618D" FontWeight="Bold" FontSize="20" DockPanel.Dock="Right" Margin="10,0,10,0" /></DockPanel>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                </DockPanel>
            </Border>

        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource Bar}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#DCEFDD" FontSize="14" />
        </Border>
    </Grid>
</Window>
