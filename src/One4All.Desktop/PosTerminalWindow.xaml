<Window x:Class="One4All.Desktop.PosTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:One4All.Desktop.ViewModels"
        Title="One4All POS" Height="820" Width="1280"
        xmlns:local="clr-namespace:One4All.Desktop"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowBg}" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVis" />
        <!-- Touch-sized action button -->
        <Style x:Key="PadButton" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#34495E" />
            <Setter Property="BorderThickness" Value="{DynamicResource Edge}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductButton" TargetType="Button" BasedOn="{StaticResource PadButton}">
            <Setter Property="Height" Value="88" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Background" Value="#2C3E50" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <SolidColorBrush x:Key="Panel" Color="#26313A" />
        <SolidColorBrush x:Key="Muted" Color="#9AA7B0" />
        <SolidColorBrush x:Key="WindowBg" Color="#1E272E" />
        <SolidColorBrush x:Key="Card" Color="#1F2A33" />
        <SolidColorBrush x:Key="Bar" Color="#0F1519" />
        <SolidColorBrush x:Key="Ink" Color="White" />
        <SolidColorBrush x:Key="EdgeBrush" Color="Transparent" />
        <Thickness x:Key="Edge">0</Thickness>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F9" Command="{Binding NextCurrencyCommand}" />
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="One4All &#8226; Point of Sale" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ProfileText}" FontSize="15" Foreground="{DynamicResource Muted}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                       ToolTip="{Binding FunctionKeysText}" />
            <Button Content="Close" Style="{StaticResource PadButton}" Width="110" Background="#7F8C8D" Click="Close_Click" DockPanel.Dock="Right" />
            <ToggleButton x:Name="ContrastToggle" Content="High contrast" Width="150" Height="56" Margin="4" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Right"
                          Checked="Contrast_Changed" Unchecked="Contrast_Changed" ToolTip="Black background, white and yellow text, outlined buttons (accessibility)" />
            <Border DockPanel.Dock="Right" Background="#E67E22" CornerRadius="12" Padding="12,4" Margin="0,0,12,0" VerticalAlignment="Center"
                    Visibility="{Binding PendingOfflineCount, Converter={StaticResource CountToVis}}">
                <TextBlock Text="{Binding SyncState}" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding CashierName, StringFormat='Cashier: {0}'}" Foreground="{DynamicResource Muted}" FontSize="14"
                       DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- Left: categories + products -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Weigh" Height="36" Width="90" FontSize="14" Background="#6C3483" Command="{Binding WeighCommand}" DockPanel.Dock="Right"
                                >
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PadButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScaleVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Add" Style="{StaticResource PadButton}" Height="36" Width="70" FontSize="14" Background="#1E8449" Command="{Binding ScanCommand}" DockPanel.Dock="Right" />
                        <TextBox x:Name="ScanBox" Text="{Binding ScanEntry, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="6,4" Margin="0,0,6,0"
                                 ToolTip="Scan a barcode or type a PLU / item code and press Enter (type a quantity on the pad first for more than one)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <!-- Product finder filters (brand, supplier, price band, in stock, on promotion, sold this week) -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="Filters…" Style="{StaticResource PadButton}" Height="30" Width="90" FontSize="13" Background="#34495E" Command="{Binding ToggleFinderCommand}"
                                DockPanel.Dock="Left" ToolTip="Find items by brand, supplier, price band, stock, promotion or recent sales" />
                        <WrapPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinderOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <TextBlock Text="Brand" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox IsEditable="True" Width="110" ItemsSource="{Binding FinderBrands}" Text="{Binding FinderBrand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <TextBlock Text="Supplier" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox IsEditable="True" Width="100" ItemsSource="{Binding FinderSuppliers}" Text="{Binding FinderSupplier, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <TextBlock Text="Price" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="55" Text="{Binding FinderMinPrice, UpdateSourceTrigger=PropertyChanged}" ToolTip="Lowest price" />
                            <TextBlock Text="–" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="3,0" />
                            <TextBox Width="55" Text="{Binding FinderMaxPrice, UpdateSourceTrigger=PropertyChanged}" ToolTip="Highest price" Margin="0,0,8,0" />
                            <CheckBox Content="In stock" IsChecked="{Binding FinderInStock}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox Content="On promotion" IsChecked="{Binding FinderPromotion}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox Content="Sold this week" IsChecked="{Binding FinderRecent}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Find" Width="60" Height="26" Command="{Binding ApplyFinderCommand}" Margin="0,0,4,0" />
                            <Button Content="Clear" Width="60" Height="26" Command="{Binding ClearFinderCommand}" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CategoryPath}" Foreground="{DynamicResource Ink}" Opacity="0.75" FontSize="12" Margin="4,0,0,2" />
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,6" Margin="3" CornerRadius="14" Background="#34495E">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Ink}" FontSize="14" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Till functions: adjustments (supervised), loyalty, park / resume -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Card}" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="2">
                                    <TextBlock Text="Supervisor" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding SupervisorName}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Supervisor PIN" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <PasswordBox x:Name="SupervisorPinBox" PasswordChanged="SupervisorPin_Changed" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Loyalty member" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding LoyaltyMember}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Discount a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding DiscountAccountCode}" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <Button Content="Line % off" Style="{StaticResource PadButton}" Height="40" FontSize="14" Background="#D35400" Command="{Binding DiscountLineCommand}" />
                                <Button Content="Sale % off" Style="{StaticResource PadButton}" Height="40" FontSize="14" Background="#D35400" Command="{Binding DiscountSaleCommand}" />
                                <Button Content="Price override" Style="{StaticResource PadButton}" Height="40" FontSize="14" Background="#A04000" Command="{Binding OverridePriceCommand}" />
                                <Button Content="Park" Style="{StaticResource PadButton}" Height="40" FontSize="14" Background="#2C3E50" Command="{Binding ParkCommand}" />
                            </UniformGrid>
                            <DockPanel Margin="0,4,0,0">
                                <Button Content="Coupon" Style="{StaticResource PadButton}" Height="34" Width="100" FontSize="14" Background="#16A085" Command="{Binding ApplyCouponCommand}" DockPanel.Dock="Right" />
                                <TextBox Text="{Binding CouponEntry, UpdateSourceTrigger=PropertyChanged}" ToolTip="Coupon code" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <Button Content="Resume" Style="{StaticResource PadButton}" Height="34" Width="100" FontSize="14" Background="#2C3E50" Command="{Binding ResumeCommand}" DockPanel.Dock="Right" />
                                <TextBox Width="120" Text="{Binding ParkTag}" ToolTip="Name to park the sale under" DockPanel.Dock="Left" Margin="2,0,6,0" />
                                <ComboBox ItemsSource="{Binding ParkedSales}" SelectedItem="{Binding SelectedParkedSale}" Margin="0,0,6,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock><Run Text="{Binding Tag}" /><Run Text="  ·  " /><Run Text="{Binding Total, StringFormat=N2}" /><Run Text="  ·  " /><Run Text="{Binding ParkedAt, StringFormat=HH:mm}" /></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap"
                                       Text="Tap a cart line to select it, type the % or price on the pad, then press the button. Over the cashier's limit, and every price override, needs a supervisor's name and PIN." />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PosProductVm}">
                                    <Button Style="{StaticResource ProductButton}" Background="{Binding TileBrush}"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AllowDrop="True"
                                            PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" PreviewMouseMove="Tile_PreviewMouseMove" Drop="Tile_Drop">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" />
                                            <TextBlock Text="{Binding PriceText}" Foreground="#7FE0A0" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right: setup + cart + totals + tender -->
            <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Session / account setup -->
                    <Border Grid.Row="0" Background="{DynamicResource Card}" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="2">
                                    <TextBlock Text="Cash a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding CashAccountCode}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Card a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding CardAccountCode}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Tax a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding TaxAccountCode}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Mobile money a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding MobileMoneyAccountCode}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Gift card a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding GiftCardAccountCode}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Tips a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding TipsAccountCode}" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <CheckBox Margin="2" VerticalAlignment="Bottom" Foreground="{DynamicResource Muted}" Content="Age checked" IsChecked="{Binding AgeVerified}" />
                                <StackPanel Margin="2">
                                    <TextBlock Text="Prescription ref" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding PrescriptionReference}" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <StackPanel Margin="2">
                                    <TextBlock Text="Over/short a/c" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding OverShortAccountCode}" />
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="Counted cash (Z)" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBox Text="{Binding CountedCash}" />
                                </StackPanel>
                            </UniformGrid>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="Float" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <TextBox Width="90" Text="{Binding OpeningFloat}" DockPanel.Dock="Left" />
                                <Button Content="Open Till" Style="{StaticResource PadButton}" Height="36" Width="120" Background="#27AE60"
                                        Command="{Binding OpenTillCommand}" DockPanel.Dock="Right" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cart -->
                    <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="6" Padding="4">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PosCartLineVm}">
                                    <Grid Margin="2">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2E4A62" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Ink}" FontSize="15" />
                                            <TextBlock Text="{Binding Quantity, StringFormat='× {0}'}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Text="{Binding Detail}" Foreground="#F5B041" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LineGrossText}" Foreground="{DynamicResource Ink}" FontSize="15"
                                                   VerticalAlignment="Center" Margin="6,0" MinWidth="64" TextAlignment="Right" />
                                        <Button Grid.Column="2" Content="&#8722;" Style="{StaticResource PadButton}" Width="40" Height="40" FontSize="22"
                                                Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Content="+" Style="{StaticResource PadButton}" Width="40" Height="40" FontSize="22"
                                                Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="4" Content="&#215;" Style="{StaticResource PadButton}" Width="40" Height="40" FontSize="20" Background="#C0392B"
                                                Command="{Binding DataContext.VoidLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Totals -->
                    <Border Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="6" Padding="10" Margin="0,8,0,8">
                        <StackPanel>
                            <DockPanel><TextBlock Text="Subtotal" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding SubtotalText}" Foreground="{DynamicResource Ink}" DockPanel.Dock="Right" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="Tax" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding TaxText}" Foreground="{DynamicResource Ink}" DockPanel.Dock="Right" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="TOTAL" Foreground="{DynamicResource Ink}" FontWeight="Bold" FontSize="22" /><TextBlock Text="{Binding GrossText}" Foreground="#7FE0A0" FontWeight="Bold" FontSize="22" DockPanel.Dock="Right" /></DockPanel>
                            <Separator Margin="0,4" />
                            <DockPanel><TextBlock Text="Tendered" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding TenderedText}" Foreground="{DynamicResource Ink}" DockPanel.Dock="Right" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="Balance" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding BalanceText}" Foreground="#E67E22" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="Change" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding ChangeText}" Foreground="#7FE0A0" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tender pad -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Numeric entry -->
                        <StackPanel Grid.Column="0">
                            <Border Background="{DynamicResource Bar}" CornerRadius="6" Padding="8" Margin="4">
                                <TextBlock Text="{Binding TenderEntry}" Foreground="{DynamicResource Ink}" FontSize="22" TextAlignment="Right" MinHeight="26" />
                            </Border>
                            <UniformGrid Columns="3">
                                <Button Content="7" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="7" />
                                <Button Content="8" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="8" />
                                <Button Content="9" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="9" />
                                <Button Content="4" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="4" />
                                <Button Content="5" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="5" />
                                <Button Content="6" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="6" />
                                <Button Content="1" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="1" />
                                <Button Content="2" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="2" />
                                <Button Content="3" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="3" />
                                <Button Content="." Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="." />
                                <Button Content="0" Style="{StaticResource PadButton}" Command="{Binding AppendDigitCommand}" CommandParameter="0" />
                                <Button Content="C" Style="{StaticResource PadButton}" Background="#7F8C8D" Command="{Binding ClearEntryCommand}" />
                            </UniformGrid>
                        </StackPanel>

                        <!-- Tender / complete -->
                        <StackPanel Grid.Column="1">
                            <Button Content="CASH" Style="{StaticResource PadButton}" Height="64" Background="#2980B9" Command="{Binding TenderCashCommand}" />
                            <UniformGrid Columns="3">
                                <Button Content="CARD" Style="{StaticResource PadButton}" Height="64" Background="#8E44AD" Command="{Binding TenderCardCommand}" />
                                <Button Content="MOBILE" Style="{StaticResource PadButton}" Height="64" Background="#117A65" Command="{Binding TenderMobileMoneyCommand}" />
                                <Button Content="VOUCHER" Style="{StaticResource PadButton}" Height="64" Background="#B9770E" Command="{Binding TenderVoucherCommand}" />
                            </UniformGrid>
                            <DockPanel Margin="2,0,2,4">
                                <TextBlock Text="Gift card no." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding VoucherNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel Margin="2,0,2,4">
                                <TextBlock DockPanel.Dock="Top" Margin="2,0,0,2" FontSize="11" Foreground="{DynamicResource Muted}">
                                    <Run Text="{Binding PayingInText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  — click a currency or press F9" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding BalanceInTenderCurrencyText}" Margin="2,2,0,0" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding CurrencyButtons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Code}" ToolTip="{Binding Tip}" MinWidth="64" Height="40" Margin="2" FontSize="15" FontWeight="SemiBold" Cursor="Hand"
                                                    Command="{Binding DataContext.PayInCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Code}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#D5D8DC" />
                                                        <Setter Property="Foreground" Value="#1C2833" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="BorderBrush" Value="#ABB2B9" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1F618D" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                                <Setter Property="BorderBrush" Value="#F4D03F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel Margin="2,0,2,4">
                                <Button DockPanel.Dock="Right" Content="ACCOUNT" Style="{StaticResource PadButton}" Height="36" Width="100" FontSize="14" Background="#5D6D7E" Command="{Binding TenderAccountCommand}" />
                                <TextBlock Text="Customer a/c" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding AccountCustomer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                            </DockPanel>
                            <Button Content="PAY / COMPLETE" Style="{StaticResource PadButton}" Height="72" FontSize="22" Background="#27AE60" Command="{Binding PayCommand}" />
                            <UniformGrid Columns="2">
                                <Button Content="Clear Tenders" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#7F8C8D" Command="{Binding ClearTendersCommand}" />
                                <Button Content="Split Bill" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#B9770E" Click="SplitBill_Click" />
                                <Button Content="New Sale" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#7F8C8D" Command="{Binding NewSaleCommand}" />
                                <Button Content="X-Read" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#34495E" Command="{Binding XReadCommand}" />
                                <Button Content="Z / Close" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#C0392B" Command="{Binding CloseTillCommand}" />
                                <Button Content="Sync Offline" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#16A085" Command="{Binding FlushOfflineCommand}" />
                                <Button Content="Receipt" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#2C3E50" Click="PrintReceipt_Click" />
                                <Button Content="Tip" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#1E8449" Command="{Binding AddTipCommand}"
                                        ToolTip="Type the tip in the scan box; the tenders then cover the sale and the tip" />
                                <Button Content="Hand over" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#6C3483" Command="{Binding HandOverCommand}"
                                        ToolTip="Count the drawer; the next cashier enters their name and PIN in the supervisor boxes" />
                                <Button Content="Void Sale" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#922B21" Command="{Binding VoidSaleCommand}"
                                        ToolTip="Type the sale number from the receipt in the scan box; a supervisor authorises" />
                                <Button Content="Refund Sale" Style="{StaticResource PadButton}" Height="44" FontSize="14" Background="#A04000" Command="{Binding RefundSaleCommand}"
                                        ToolTip="Type the sale number from the receipt in the scan box; refunded in cash with a supervisor's authority" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource Bar}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#DCEFDD" FontSize="14" />
        </Border>
    </Grid>
</Window>
