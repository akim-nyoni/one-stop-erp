<Window x:Class="One4All.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One4All ERP - Sign in" Height="480" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand header -->
        <Border Grid.Row="0" Background="{StaticResource BrandBrush}">
            <StackPanel VerticalAlignment="Center" Margin="32,0">
                <TextBlock Text="One4All ERP" Foreground="White" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Enterprise Resource Planning" Foreground="#DCEFDD" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="32,28,32,0">
            <TextBlock Text="User name" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" Padding="6,4" FontSize="14" />

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,4" />
            <PasswordBox x:Name="PasswordBox" Height="32" Padding="6,4" FontSize="14"
                         KeyDown="PasswordBox_KeyDown" />

            <TextBlock Text="Authenticator code (if you use one)" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBox x:Name="CodeBox" Text="{Binding OneTimeCode, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,4" FontSize="14" />

            <Button x:Name="SignInButton" Content="Sign in" Height="38" Margin="0,24,0,0"
                    FontSize="15" FontWeight="SemiBold" Foreground="White"
                    Background="{StaticResource BrandDarkBrush}" BorderThickness="0"
                    Click="SignIn_Click" Cursor="Hand" />

            <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" TextWrapping="Wrap"
                       Foreground="#555" FontSize="12.5" />

            <Border Margin="0,20,0,0" Padding="12,10" Background="#F4F7F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#666">
                    <Run Text="First run: sign in as " /><Run Text="admin" FontWeight="Bold" /><Run Text=" / " /><Run Text="Admin@123" FontWeight="Bold" /><Run Text="  (you'll be asked to change it)." />
                </TextBlock>
            </Border>
        </StackPanel>
    </Grid>
</Window>
