<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1812;CA1861;CA1865;CA1869;CA1307;CA1310;CA1311;CA1304;CA1309;CA1308</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\One4All.Desktop\One4All.Desktop.csproj" />
    <ProjectReference Include="..\..\src\One4All.Reporting\One4All.Reporting.csproj" />
  </ItemGroup>

</Project>
